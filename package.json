{
  "name": "multi-enterprise-ai-progress-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run f02:gate:prebuild && npm run build:app && npm run f02:gate:release",
    "build:app": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "postbuild:app": "npm run p2:verify:worker-bundle",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "f02:gate:prebuild": "node scripts/f02-protected-surface-gate.mjs --stage PREBUILD",
    "f02:gate:release": "node scripts/f02-protected-surface-gate.mjs --stage RELEASE",
    "p2:verify:worker-bundle": "node scripts/verify-p2-worker-runtime-bundle.mjs",
    "test": "npm run build && node --test --test-reporter=tap tests/*.test.mjs",
    "test:c03:postgres": "sh scripts/run-c03-postgres-tests.sh",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "p0:status": "node scripts/p0-gate.mjs implementation/p0/baseline.json",
    "p0:gate": "node scripts/p0-gate.mjs implementation/p0/baseline.json --strict"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pg": "8.22.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
