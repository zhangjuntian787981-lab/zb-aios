{
  "schemaVersion": "c18-retention-policy.v1",
  "status": "P1_SYNTHETIC_ONLY",
  "implementationStatus": "IMPLEMENTED",
  "verificationStatus": "EVIDENCE_CANDIDATE",
  "productionVerificationStatus": "NOT_VERIFIED",
  "policyVersion": "c18-retention-v1",
  "classes": [
    {
      "retentionClass": "AUDIT_7Y",
      "appliesTo": [
        "AUDIT_EVENT",
        "AUDIT_COMMAND_RECEIPT",
        "AUDIT_DELIVERY_INTENT"
      ],
      "retentionPeriod": "P7Y",
      "minimumDays": 2555,
      "payloadMode": "METADATA_REFERENCES_HASHES_ONLY",
      "deleteBeforeEligible": false,
      "legalHoldOverridesExpiry": true,
      "automaticDeletionStatus": "NOT_IMPLEMENTED_P1"
    },
    {
      "retentionClass": "OUTBOX_DELIVERY_30D",
      "appliesTo": [
        "PUBLISHED_OUTBOX_DELIVERY_STATE"
      ],
      "retentionPeriod": "P30D",
      "payloadMode": "STATE_ONLY_EVENT_IN_IMMUTABLE_INTENT",
      "deleteBeforePublished": false,
      "legalHoldSource": "AUDIT_DELIVERY_INTENT",
      "automaticDeletionStatus": "IMPLEMENTED_P1_BOUNDED"
    }
  ],
  "queryContract": {
    "tenantScopeRequired": true,
    "businessAdministratorRole": "aios_c18_reader",
    "maximumRows": 500,
    "requiredBounds": [
      "fromSequence",
      "toSequence",
      "fromOccurredAt",
      "toOccurredAt",
      "limit"
    ],
    "crossTenantQuery": false,
    "updateAllowed": false,
    "deleteAllowed": false
  },
  "retentionCleanupContract": {
    "postgresqlRole": "aios_c18_retention_worker",
    "tenantScopeRequired": true,
    "databaseClock": "statement_timestamp",
    "maximumRows": 500,
    "eligibleStatus": "PUBLISHED",
    "minimumAge": "P30D",
    "legalHoldMustBe": false,
    "deletes": [
      "PUBLISHED_OUTBOX_DELIVERY_STATE"
    ],
    "preserves": [
      "AUDIT_EVENT",
      "AUDIT_COMMAND_RECEIPT",
      "AUDIT_DELIVERY_INTENT"
    ]
  },
  "recoveryContract": {
    "postgresqlRole": "aios_c18_recovery_reader",
    "tenantScopeRequired": true,
    "schemaVersion": "c18-audit-recovery.v1",
    "includes": [
      "AUDIT_EVENT_CHAIN",
      "AUDIT_COMMAND_RECEIPTS",
      "NON_PUBLISHED_OUTBOX_STATE"
    ],
    "digest": "RFC_8785_SHA_256"
  },
  "archiveAndDeletionOwner": "O02_G2",
  "externalArchiveStatus": "NOT_VERIFIED",
  "checkpointSignatureStatus": "NOT_VERIFIED"
}
