{
  "openapi": "3.1.2",
  "info": {
    "title": "C12 P1 Synthetic Agent Orchestrator",
    "version": "1.0.0"
  },
  "x-c12-boundary": {
    "implementation_status": "IMPLEMENTED",
    "verification_status": "EVIDENCE_CANDIDATE",
    "verification_scope": "P1_SYNTHETIC_ONLY",
    "production_verification_status": "NOT_VERIFIED",
    "enterprise_integration_status": "P3_REQUIRED",
    "enterprise_connectors": "C0_DISABLED",
    "dynamic_graph": false,
    "free_form_multi_agent_chat": false,
    "permission_owner": "C06",
    "checkpoint_owner": "C12",
    "run_ledger_owner": "C08",
    "retrieval_owner": "C11",
    "model_owner": "C14",
    "tool_owner": "C16",
    "human_decision_owner": "HUMAN_DECISION_PORT",
    "audit_owner": "C18"
  },
  "paths": {
    "/internal/v1/orchestration/tasks:start": {
      "post": {
        "operationId": "start",
        "x-browser-direct-access": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./task-envelope.v1.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created Synthetic task checkpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskView"
                }
              }
            }
          },
          "default": {
            "description": "Rejected without a task side effect",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/orchestration/tasks:advance": {
      "post": {
        "operationId": "advance",
        "x-browser-direct-access": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdvanceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One idempotent node transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskView"
                }
              }
            }
          },
          "default": {
            "description": "Rejected without checkpoint advancement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/orchestration/tasks:resume-human-decision": {
      "post": {
        "operationId": "resumeWithHumanDecision",
        "x-browser-direct-access": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeHumanDecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HumanDecision-bound transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskView"
                }
              }
            }
          },
          "default": {
            "description": "Rejected without consuming a decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/orchestration/tasks:inspect": {
      "post": {
        "operationId": "inspect",
        "x-browser-direct-access": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InspectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Metadata-only task checkpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./node-io.v1.schema.json#/$defs/TaskState"
                }
              }
            }
          },
          "default": {
            "description": "Rejected without disclosing task state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TaskId": {
        "type": "string",
        "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "SessionFields": {
        "type": "object",
        "required": [
          "sessionToken",
          "delegationId",
          "correlationId"
        ],
        "properties": {
          "sessionToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "delegationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "AdvanceRequest": {
        "unevaluatedProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/SessionFields"
          },
          {
            "type": "object",
            "required": [
              "idempotencyKey",
              "taskId",
              "expectedVersion"
            ],
            "properties": {
              "idempotencyKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "taskId": {
                "$ref": "#/components/schemas/TaskId"
              },
              "expectedVersion": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      },
      "ResumeHumanDecisionRequest": {
        "unevaluatedProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/SessionFields"
          },
          {
            "type": "object",
            "required": [
              "idempotencyKey",
              "taskId",
              "expectedVersion",
              "expectedStateSha256",
              "decisionRef",
              "decisionSha256"
            ],
            "properties": {
              "idempotencyKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "taskId": {
                "$ref": "#/components/schemas/TaskId"
              },
              "expectedVersion": {
                "type": "integer",
                "minimum": 1
              },
              "expectedStateSha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "decisionRef": {
                "type": "string",
                "pattern": "^evidence://[A-Za-z0-9][A-Za-z0-9._~:/-]*$"
              },
              "decisionSha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      },
      "InspectRequest": {
        "unevaluatedProperties": false,
        "allOf": [
          {
            "$ref": "#/components/schemas/SessionFields"
          },
          {
            "type": "object",
            "required": ["taskId"],
            "properties": {
              "taskId": {
                "$ref": "#/components/schemas/TaskId"
              }
            }
          }
        ]
      },
      "StatePortReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "tenantId",
          "humanPrincipalId",
          "workloadActorPrincipalId",
          "taskId",
          "operation",
          "idempotencyKey",
          "requestSha256",
          "resultVersion",
          "resultStateSha256",
          "receiptSha256"
        ],
        "properties": {
          "schemaVersion": {
            "const": "c12-state-port-receipt.v1"
          },
          "tenantId": {
            "type": "string",
            "pattern": "^stn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "humanPrincipalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "workloadActorPrincipalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "taskId": {
            "$ref": "#/components/schemas/TaskId"
          },
          "operation": {
            "enum": [
              "START",
              "ADVANCE",
              "RESUME_HUMAN_DECISION"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "requestSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "resultVersion": {
            "type": "integer",
            "minimum": 1
          },
          "resultStateSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "receiptSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "TaskView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "replayed", "receipt"],
        "properties": {
          "task": {
            "$ref": "./node-io.v1.schema.json#/$defs/TaskState"
          },
          "replayed": {
            "type": "boolean"
          },
          "receipt": {
            "$ref": "#/components/schemas/StatePortReceipt"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
