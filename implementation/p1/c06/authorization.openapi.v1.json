          "reasonCode": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "inputSha256": {
            "$ref": "#/components/schemas/Sha256"
          },
          "checkTuples": {
            "$ref": "#/components/schemas/CheckTuples"
