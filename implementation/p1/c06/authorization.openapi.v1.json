          "openFgaStoreId": {
            "$ref": "#/components/schemas/OpenFgaId"
          },
          "authorizationModelId": {
            "$ref": "#/components/schemas/OpenFgaId"
          },
          "activationVersion": {
            "type": "integer",
            "minimum": 1
          },
          "consistency": {
            "const": "HIGHER_CONSISTENCY"
