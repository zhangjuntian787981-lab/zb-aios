{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/aios/c13/skill-manifest.v1.schema.json",
  "title": "C13 P1 Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "description",
    "instructions",
    "allowedTools",
    "executionMode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "allowedTools": {
      "description": "Advisory operation identifiers only. They never grant authorization.",
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$",
        "maxLength": 128
      }
    },
    "executionMode": {
      "const": "INSTRUCTIONS_ONLY"
    }
  }
}
