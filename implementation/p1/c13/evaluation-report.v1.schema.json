{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product.local/schemas/c13/evaluation-report.v1.schema.json",
  "title": "C13 EvaluationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceClass",
    "evaluationMode",
    "reportId",
    "tenantId",
    "skillName",
    "skillVersion",
    "releaseDigest",
    "suiteId",
    "suiteSha256",
    "humanBaselineDecisionRef",
    "humanBaselineDecisionSha256",
    "humanBaselineStatus",
    "reportRef",
    "reportSha256",
    "caseCount",
    "reportedCaseCount",
    "caseResults",
    "status",
    "failureCount",
    "zeroToleranceViolationCount",
    "reasonCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "c13-evaluation-report.v1"
    },
    "evidenceClass": {
      "enum": [
        "FROZEN_SYNTHETIC",
        "TEST_ONLY"
      ]
    },
    "evaluationMode": {
      "enum": [
        "DETERMINISTIC_BUILTIN_F04_GATE",
        "TEST_ONLY_VALIDATED_FIXTURE"
      ]
    },
    "reportId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenantId": {
      "type": "string"
    },
    "skillName": {
      "type": "string"
    },
    "skillVersion": {
      "type": "string"
    },
    "releaseDigest": {
      "$ref": "#/$defs/sha256"
    },
    "suiteId": {
      "const": "f04-frozen-evaluation-suite-v1"
    },
    "suiteSha256": {
      "$ref": "#/$defs/sha256"
    },
    "humanBaselineDecisionRef": {
      "type": "string"
    },
    "humanBaselineDecisionSha256": {
      "$ref": "#/$defs/sha256"
    },
    "humanBaselineStatus": {
      "const": "VALIDATED"
    },
    "reportRef": {
      "type": "string"
    },
    "reportSha256": {
      "$ref": "#/$defs/sha256"
    },
    "caseCount": {
      "const": 10
    },
    "reportedCaseCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "caseResults": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "failureCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "zeroToleranceViolationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "outcome",
        "score",
        "evidenceRef"
      ],
      "properties": {
        "caseId": {
          "pattern": "^F04-E00[1-9]$|^F04-E010$",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
