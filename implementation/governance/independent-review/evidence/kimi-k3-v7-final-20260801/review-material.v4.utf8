{"schemaVersion":"moonshot-kimi-k3-model-visible-protocol.v3","reviewerProvider":"moonshot","reviewerModel":"kimi-k3","baseURL":"https://api.moonshot.ai/v1","endpoint":"/chat/completions","tokenEstimateEndpoint":"/tokenizers/estimate-token-count","contextWindowTokens":1048576,"reasoningEffort":"max","thinkingOmitted":true,"toolChoice":"none","toolsOmitted":true,"responseFormat":{"type":"json_schema","strict":true,"name":"independent_model_review_output_v2"},"forbiddenRequestFields":["frequency_penalty","n","presence_penalty","temperature","thinking","tools","top_p"],"maxCompletionTokens":32768,"safetyMarginTokens":8192,"nonMessageVisibleTokenReserve":65536,"nonMessageVisibleInputMaxUtf8Bytes":16384,"nonMessageVisibleInputCanonicalization":"JSON_UTF8_FIXED_REQUEST_WITHOUT_MESSAGES_V1","tokenEstimateCoverage":"EXACT_MESSAGES_PLUS_FIXED_NON_MESSAGE_RESERVE","maxReviewMaterialUtf8Bytes":4194304,"maxRequestUtf8Bytes":8388608,"maxResponseUtf8Bytes":1048576,"contextBudgetBasis":"TRANSPORT_RESOURCE_CEILING_ONLY_NOT_CONTEXT_PROOF","pricing":{"currency":"USD","taxBasis":"TAX_EXCLUSIVE","unitTokens":1000000,"cacheHitInputMicrosPerMillion":300000,"cacheMissInputMicrosPerMillion":3000000,"outputMicrosPerMillion":15000000,"asOf":"2026-08-01"},"taxExclusiveBudgetMicros":4000000,"fallbackPolicy":"DISABLED_FAIL_CLOSED"}
