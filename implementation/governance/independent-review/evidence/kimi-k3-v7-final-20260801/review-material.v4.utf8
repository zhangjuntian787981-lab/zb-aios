+    const terminator = raw.indexOf(0, offset);
+    if (terminator === -1) {
+      throw new TypeError("Git tree output is not NUL terminated.");
+    }
+    const recordBytes = raw.subarray(offset, terminator);
+    offset = terminator + 1;
