          "$ref": "#/$defs/sha256"
        },
        "nodeExecutableSha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependencySetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "gitToolchainSha256": {
          "$ref": "#/$defs/sha256"
        },
        "systemToolchainSha256": {
          "$ref": "#/$defs/sha256"
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "gitBlobSha256",
            "executedBytesSha256"
          ],
          "properties": {
