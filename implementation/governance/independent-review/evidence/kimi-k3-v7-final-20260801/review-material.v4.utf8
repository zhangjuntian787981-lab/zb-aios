              "const": "lib/independent-review-runtime-binding.mjs"
            },
            "gitBlobSha256": {
              "$ref": "#/$defs/sha256"
            },
            "executedBytesSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "executionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "cloneMode",
        "before",
        "after",
        "unchanged",
        "gitHistory",
        "sourceExportRemoved",
        "sandbox"
      ],
      "properties": {
        "mode": {
          "const": "MACOS_SEATBELT_GIT_ARCHIVE_READONLY_HISTORY_V3"
        },
        "cloneMode": {
          "const": "GIT_ARCHIVE_WITH_READ_ONLY_HISTORY_SNAPSHOT"
        },
        "before": {
          "$ref": "#/$defs/executionSnapshot"
        },
        "after": {
          "$ref": "#/$defs/executionSnapshot"
        },
        "unchanged": {
          "const": true
        },
        "gitHistory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "sourceCommit",
            "sourceTree",
            "refTipCount",
            "refTipSetSha256",
            "reachableObjectCount",
            "reachableObjectSetSha256",
            "pointerSha256",
            "beforeManifestSha256",
            "afterManifestSha256",
            "unchanged",
            "metadataWritable"
          ],
          "properties": {
            "mode": {
              "const": "READ_ONLY_ALL_REF_REACHABLE_OBJECT_SNAPSHOT"
            },
            "sourceCommit": {
              "$ref": "#/$defs/commit"
            },
            "sourceTree": {
              "$ref": "#/$defs/commit"
            },
            "refTipCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "refTipSetSha256": {
