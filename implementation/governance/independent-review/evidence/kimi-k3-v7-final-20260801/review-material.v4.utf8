        },
        "reviewerSessionId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "reviewerIndependentOfImplementation": {
          "const": true
        },
        "implementationProvider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "implementationModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "const": "kimi-k2.7-code"
          }
        },
        "diversityLevel": {
          "const": "DIFFERENT_MODEL_ID_DIFFERENT_PROVIDER"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCommit",
        "sourceCommit",
        "headCommit",
        "tree",
        "diffSha256",
        "changedPathsDigest",
        "gitDiffCheck"
      ],
      "properties": {
