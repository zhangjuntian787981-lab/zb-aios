          "const": 65536
        },
        "nonMessageVisibleInputByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "nonMessageVisibleInputSha256": {
          "$ref": "#/$defs/sha256"
        },
        "contextWindowTokens": {
