{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-model-review-receipt.v3.schema.json",
  "title": "Independent model review Receipt v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "receiptSchemaVersion",
    "reviewId",
    "policyVersion",
    "policySha256",
    "assuranceLevel",
    "applicablePhase",
    "humanIndependentReviewSatisfied",
    "independentModelReviewRequired",
    "p3HumanReviewRequired",
    "bundleId",
    "bundleSha256",
    "reviewMaterialSha256",
    "reviewer",
    "source",
    "bindings",
    "artifacts",
    "isolationEvidence",
    "reviewedPaths",
    "findings",
    "testEvidenceDigests",
    "decision",
    "conclusion",
    "historicalTerraEvidenceAccepted",
    "humanReviewClaim",
    "governanceEffect",
    "selfAuthorizing",
    "startedAt",
    "finishedAt",
    "recordedAt",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "independent-model-review-receipt.v3"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^imrr_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "receiptSchemaVersion": {
      "const": "independent-model-review-receipt.v3"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^imrr_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "policyVersion": {
      "const": "2.0.0-candidate.3"
    },
    "policySha256": {
      "$ref": "#/$defs/sha256"
    },
    "assuranceLevel": {
      "const": "MODEL_ONLY_PREPRODUCTION"
    },
    "applicablePhase": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "humanIndependentReviewSatisfied": {
      "const": false
    },
    "independentModelReviewRequired": {
      "const": true
    },
    "p3HumanReviewRequired": {
      "const": true
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "bundleSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewMaterialSha256": {
