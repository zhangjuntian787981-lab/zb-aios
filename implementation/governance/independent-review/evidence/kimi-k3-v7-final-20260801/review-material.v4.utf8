      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "testEvidenceDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "decision": {
      "enum": [
        "CLEAR",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "conclusion": {
      "enum": [
        "MODEL_REVIEW_CLEAR_FOR_PREPRODUCTION",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "historicalTerraEvidenceAccepted": {
      "const": false
    },
    "historicalK2EvidenceAccepted": {
      "const": false
    },
    "humanReviewClaim": {
      "const": false
    },
    "governanceEffect": {
      "const": "NONE"
    },
    "selfAuthorizing": {
      "const": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "receiptSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "micros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4000000
    },
    "byteArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "encoding",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "encoding": {
          "const": "UTF-8"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gitDiffCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "checkId",
        "executionMode",
        "baseCommit",
        "sourceCommit",
        "sourceTree",
        "checkedPatchSha256",
        "runnerPath",
        "runnerGitBlobSha256",
        "runnerExecutedBytesSha256",
        "gitExecutable",
        "gitVersion",
        "logicalCommandSha256",
        "environmentSha256",
        "exitCode",
        "status",
        "stdoutSha256",
        "stdoutByteLength",
        "stderrSha256",
        "stderrByteLength",
        "resultSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": "independent-review-git-diff-check.v1"
        },
        "checkId": {
          "const": "base-to-source-diff-check"
        },
        "executionMode": {
          "const": "TRUSTED_GIT_OBJECT_DATABASE_CONTROL_PLANE"
        },
        "baseCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceTree": {
          "$ref": "#/$defs/commit"
        },
        "checkedPatchSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnerPath": {
          "$ref": "#/$defs/path"
        },
        "runnerGitBlobSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnerExecutedBytesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "gitExecutable": {
          "const": "/usr/bin/git"
        },
        "gitVersion": {
          "type": "string",
          "pattern": "^git version [^\\r\\n]{1,128}$"
        },
        "logicalCommandSha256": {
          "$ref": "#/$defs/sha256"
        },
        "environmentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "exitCode": {
          "const": 0
        },
        "status": {
          "const": "PASS"
        },
        "stdoutSha256": {
          "const": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "stdoutByteLength": {
          "const": 0
        },
        "stderrSha256": {
          "const": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "stderrByteLength": {
          "const": 0
        },
        "resultSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "modelToolCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileRead",
        "fileWrite",
        "shell",
        "git",
        "browser",
        "d1",
        "sites",
        "governanceDecision"
      ],
      "properties": {
        "fileRead": {
          "const": false
        },
        "fileWrite": {
          "const": false
        },
        "shell": {
          "const": false
        },
        "git": {
          "const": false
        },
        "browser": {
          "const": false
        },
        "d1": {
          "const": false
        },
        "sites": {
          "const": false
        },
        "governanceDecision": {
          "const": false
        }
      }
    },
    "repositorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "tree",
        "worktreeStatusSha256",
        "worktreeContentManifestSha256",
        "worktreePathCount",
        "protectedPathSetSha256",
        "protectedFilesDigest",
        "ignoredExclusionPolicySha256",
        "ignoredExcludedPathCount"
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/commit"
        },
        "tree": {
          "$ref": "#/$defs/commit"
        },
        "worktreeStatusSha256": {
          "$ref": "#/$defs/sha256"
        },
        "worktreeContentManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "worktreePathCount": {
          "type": "integer",
          "minimum": 0
        },
        "protectedPathSetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "protectedFilesDigest": {
          "$ref": "#/$defs/sha256"
        },
        "ignoredExclusionPolicySha256": {
          "$ref": "#/$defs/sha256"
        },
        "ignoredExcludedPathCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtimeTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtimeCommit",
        "runtimeTree",
        "subjectCommit",
        "subjectTree",
        "bootstrapSha256",
        "launcherSha256",
        "runtimeManifestGitBlobSha256",
        "runnerGitBlobSha256"
      ],
      "properties": {
        "mode": {
          "const": "ANCESTOR_RUNTIME_COMMIT"
        },
        "runtimeCommit": {
          "$ref": "#/$defs/commit"
        },
        "runtimeTree": {
          "$ref": "#/$defs/commit"
        },
        "subjectCommit": {
          "$ref": "#/$defs/commit"
        },
        "subjectTree": {
          "$ref": "#/$defs/commit"
        },
        "bootstrapSha256": {
          "$ref": "#/$defs/sha256"
        },
        "launcherSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtimeManifestGitBlobSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnerGitBlobSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtimeDependencyManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "gitBlobSha256",
        "schemaPath",
        "schemaGitBlobSha256",
        "manifestSha256",
        "nodeExecutableSha256",
        "fullDependencyTreeSha256",
        "npmPackageTreeSha256"
      ],
      "properties": {
        "path": {
          "const": "implementation/governance/independent-review/kimi-runtime-manifest.v4.json"
        },
        "gitBlobSha256": {
          "$ref": "#/$defs/sha256"
        },
        "schemaPath": {
          "const": "implementation/governance/schemas/independent-review-runtime-manifest.v4.schema.json"
        },
        "schemaGitBlobSha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "nodeExecutableSha256": {
          "$ref": "#/$defs/sha256"
        },
        "fullDependencyTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "npmPackageTreeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "severity",
        "status",
        "path",
        "startLine",
        "endLine",
        "summary",
        "detailsSha256",
        "resolutionEvidenceDigests"
      ],
      "properties": {
        "findingId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,127}$"
        },
        "severity": {
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "status": {
          "enum": [
            "OPEN",
            "RESOLVED"
          ]
        },
        "path": {
          "oneOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "startLine": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "endLine": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "detailsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolutionEvidenceDigests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}

