{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-review-runtime-manifest.v1.schema.json",
  "title": "Independent review runtime dependency manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "environment",
    "node",
    "npm",
    "source",
    "dependencies",
    "manifestSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "independent-review-runtime-dependency-manifest.v1"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "enum": ["darwin", "linux"] },
        "arch": { "enum": ["arm64", "x64"] }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeOptionsRequiredAbsent",
        "nodePathRequiredAbsent",
        "requiredExecArgv"
      ],
      "properties": {
        "nodeOptionsRequiredAbsent": { "const": true },
        "nodePathRequiredAbsent": { "const": true },
        "requiredExecArgv": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "executablePathSha256",
        "executableByteLength",
        "executableSha256"
      ],
      "properties": {
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "executablePathSha256": { "$ref": "#/$defs/sha256" },
        "executableByteLength": { "type": "integer", "minimum": 1 },
        "executableSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "npm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "launcherTargetSha256",
        "cliPathSha256",
        "cliByteLength",
        "cliSha256",
        "packageJsonSha256",
        "packageTreeEntryCount",
        "packageTreeByteLength",
        "packageTreeSha256"
      ],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "launcherTargetSha256": { "$ref": "#/$defs/sha256" },
        "cliPathSha256": { "$ref": "#/$defs/sha256" },
        "cliByteLength": { "type": "integer", "minimum": 1 },
        "cliSha256": { "$ref": "#/$defs/sha256" },
        "packageJsonSha256": { "$ref": "#/$defs/sha256" },
        "packageTreeEntryCount": { "type": "integer", "minimum": 1 },
        "packageTreeByteLength": { "type": "integer", "minimum": 1 },
        "packageTreeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageJsonSha256",
        "packageLockSha256",
        "localModuleSubjects",
        "localClosureSha256"
      ],
      "properties": {
        "packageJsonSha256": { "$ref": "#/$defs/sha256" },
        "packageLockSha256": { "$ref": "#/$defs/sha256" },
        "localModuleSubjects": {
