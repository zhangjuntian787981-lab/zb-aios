{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-model-review-receipt.v8.schema.json",
  "title": "Independent Model Review Receipt v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "receiptSchemaVersion",
    "reviewId",
    "policyVersion",
    "policySha256",
    "assuranceLevel",
    "applicablePhase",
