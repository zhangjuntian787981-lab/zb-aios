{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-model-review-output.v2.schema.json",
  "title": "Independent Model Review Output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewSummary",
    "findings",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "independent-model-review-output.v2"
    },
    "reviewSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "decision": {
      "enum": [
        "CLEAR",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    },
    "line": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "severity",
        "status",
        "path",
        "startLine",
        "endLine",
        "summary",
        "detailsSha256",
        "resolutionEvidenceDigests"
      ],
      "properties": {
        "findingId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,127}$"
        },
        "severity": {
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "status": {
          "enum": [
            "OPEN",
            "RESOLVED"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "startLine": {
          "$ref": "#/$defs/line"
        },
        "endLine": {
          "$ref": "#/$defs/line"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "detailsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolutionEvidenceDigests": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}

6024
diff --git a/implementation/governance/independent-review/independent-review-test-plan.v2.json b/implementation/governance/independent-review/independent-review-test-plan.v2.json
index aa6b70a441bdecb638145f45138838879fe77726..d3c4ae2a20c398e15e5744dcebcecb28cea83b1f 100644
--- a/implementation/governance/independent-review/independent-review-test-plan.v2.json
+++ b/implementation/governance/independent-review/independent-review-test-plan.v2.json
@@ -6 +6 @@
-      "commandId": "independent-review-targeted",
+      "commandId": "formal-targeted-with-recursive-skips",
@@ -9,0 +10 @@
+        "--test-reporter=tap",
@@ -13 +14,25 @@
-      "timeoutMs": 120000
+      "timeoutMs": 120000,
+      "testExpectation": {
+        "format": "NODE_TEST_TAP",
+        "reporter": "TAP",
+        "tests": 85,
+        "pass": 74,
+        "fail": 0,
+        "cancelled": 0,
+        "skipped": 11,
+        "todo": 0,
+        "allowedSkippedTestNames": [
+          "A failing command observed by the frozen collector cannot become PASS evidence",
+          "A passing command that creates an untracked file in its isolated frozen source cannot become PASS evidence",
+          "A passing command that mutates its isolated frozen source cannot become PASS evidence",
+          "Dirty working-tree bytes cannot impersonate bytes frozen in sourceCommit",
+          "Git Bundle generator binds the exact parent, source commit, tree, diff, and all changed paths",
+          "an unlisted TAP skip cannot become PASS evidence",
+          "frozen npm configuration cannot be rewritten or injected through a case-aliased project file",
+          "the frozen Git history contains every exact ref-reachable canary and excludes dangling objects",
+          "the frozen collector mounts exact read-only Git history, protects source and dependencies, permits bounded outputs and nested tools, and denies all network",
+          "the frozen collector rejects a transcript containing the active Moonshot credential",
+          "the frozen test-result Schema is executed against collected evidence"
+        ],
+        "allowedSkippedTestSetSha256": "sha256:2ef860907601acb5a34eb12598cf4fe0107fdd90886750929b3ab84055f7822b"
+      }
@@ -16 +41 @@
-      "commandId": "full-repository-gates",
+      "commandId": "formal-repository-gates-with-recursive-skips",
@@ -21 +46,43 @@
-      "timeoutMs": 600000
+      "timeoutMs": 600000,
+      "testExpectation": {
+        "format": "NODE_TEST_TAP",
+        "reporter": "TAP",
+        "tests": 1655,
+        "pass": 1626,
+        "fail": 0,
+        "cancelled": 0,
+        "skipped": 29,
+        "todo": 0,
+        "allowedSkippedTestNames": [
+          "A failing command observed by the frozen collector cannot become PASS evidence",
+          "A passing command that creates an untracked file in its isolated frozen source cannot become PASS evidence",
+          "A passing command that mutates its isolated frozen source cannot become PASS evidence",
+          "Dirty working-tree bytes cannot impersonate bytes frozen in sourceCommit",
+          "Dirty workspace bytes and tampered Bundle or test evidence cannot impersonate frozen Review Material",
+          "Git Bundle generator binds the exact parent, source commit, tree, diff, and all changed paths",
+          "Kimi request and Receipt replace a fully forged PASS closure with fresh trusted evidence",
+          "Kimi runner discards caller-rehashed test evidence and rebuilds the frozen test plan result",
+          "Kimi runner fails closed before network without a trusted runtime closure verifier",
+          "Kimi runner performs zero network calls without a credential",
+          "Kimi runner re-executes the frozen test plan instead of trusting a fully forged PASS closure",
+          "Kimi runner re-proves Bundle patch and scope from the real source commit",
+          "Kimi runner rejects a symlinked output parent before network or repository writes",
+          "Kimi runner writes only sanitized exact-byte artifacts outside the unchanged repository",
+          "Kimi test harness cannot publish a formal Receipt from injected controls",
+          "Kimi test harness never freezes model outcomes as formal Receipts",
+          "Review Material v2 re-reads exact source changes and frozen evidence into one bounded Envelope",
+          "a caller-authored PASS cannot override a raw observation that did not show OS denial",
+          "a protected byte change cannot hide behind an unchanged dirty status",
+          "a rehashed result cannot replace the frozen sandbox template binding",
+          "an unlisted TAP skip cannot become PASS evidence",
+          "frozen local control plane derives all twelve read-only probes from raw observations",
+          "frozen npm configuration cannot be rewritten or injected through a case-aliased project file",
+          "tampered raw evidence and binding drift fail closed",
+          "the cumulative K3 candidate uses the additive v3 byte-defense budget",
+          "the frozen Git history contains every exact ref-reachable canary and excludes dangling objects",
+          "the frozen collector mounts exact read-only Git history, protects source and dependencies, permits bounded outputs and nested tools, and denies all network",
+          "the frozen collector rejects a transcript containing the active Moonshot credential",
+          "the frozen test-result Schema is executed against collected evidence"
+        ],
+        "allowedSkippedTestSetSha256": "sha256:f03f78d2d37dbef1d77d2a164bcfd3b4b23d01a1986e7d3d5d88b70427f1ac28"
+      }
@@ -31,9 +97,0 @@
-    },
-    {
-      "commandId": "diff-check",
-      "executable": "GIT",
-      "args": [
-        "diff",
-        "--check"
-      ],
-      "timeoutMs": 60000
@@ -42 +100 @@
