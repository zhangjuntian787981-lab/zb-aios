          "$ref": "#/$defs/runtimeDependencyManifest"
        }
      }
    },
    "reviewedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "testEvidenceDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "decision": {
      "enum": [
        "CLEAR",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "conclusion": {
      "enum": [
        "MODEL_REVIEW_CLEAR_FOR_PREPRODUCTION",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
