@@ -396,0 +459,981 @@ function result(ok, status, reasonCodes, extra = {}) {
+const TAP_SUMMARY_KEYS = Object.freeze([
+  "format",
+  "tests",
+  "pass",
+  "fail",
+  "cancelled",
+  "skipped",
+  "todo",
+  "skippedTestNames",
+  "skippedTestSetSha256",
+]);
+const TAP_EXPECTATION_KEYS = Object.freeze([
+  "format",
+  "reporter",
+  "tests",
+  "pass",
+  "fail",
+  "cancelled",
+  "skipped",
+  "todo",
+  "allowedSkippedTestNames",
+  "allowedSkippedTestSetSha256",
+]);
+const TAP_COUNT_FIELDS = Object.freeze([
+  "tests",
+  "pass",
+  "fail",
+  "cancelled",
+  "skipped",
+  "todo",
+]);
+
+function sortedUtf8Strings(values) {
+  return [...values].sort((left, right) =>
+    Buffer.compare(Buffer.from(left, "utf8"), Buffer.from(right, "utf8")),
+  );
+}
+
+function validTapTestNames(values) {
+  return (
+    Array.isArray(values) &&
+    values.length <= 4096 &&
+    values.every(
+      (value) =>
+        typeof value === "string" &&
+        value.length > 0 &&
+        value.length <= 512 &&
+        !/[\u0000-\u001f]/u.test(value),
+    ) &&
+    unique(values) &&
+    canonicalizeProjectJson(values) ===
+      canonicalizeProjectJson(sortedUtf8Strings(values))
+  );
+}
+
+async function validTapExpectation(expectation) {
+  return (
+    keysExactly(expectation, TAP_EXPECTATION_KEYS) &&
+    expectation.format === "NODE_TEST_TAP" &&
+    expectation.reporter === "TAP" &&
+    TAP_COUNT_FIELDS.every(
+      (field) =>
+        Number.isInteger(expectation[field]) &&
+        expectation[field] >= 0 &&
+        expectation[field] <= 1_000_000,
+    ) &&
+    expectation.tests ===
+      expectation.pass +
+        expectation.fail +
+        expectation.cancelled +
+        expectation.skipped +
+        expectation.todo &&
+    expectation.fail === 0 &&
+    expectation.cancelled === 0 &&
+    expectation.todo === 0 &&
+    validTapTestNames(expectation.allowedSkippedTestNames) &&
+    expectation.allowedSkippedTestNames.length === expectation.skipped &&
+    SHA256.test(expectation.allowedSkippedTestSetSha256 ?? "") &&
+    expectation.allowedSkippedTestSetSha256 ===
+      (await sha256ProjectValue(expectation.allowedSkippedTestNames))
+  );
+}
+
+function commandRequiresTapExpectation(command) {
+  return (
+    (command?.executable === "NODE" &&
+      Array.isArray(command.args) &&
+      command.args.includes("--test")) ||
+    (command?.executable === "NPM" &&
+      canonicalizeProjectJson(command.args) ===
+        canonicalizeProjectJson(["test"]))
+  );
+}
+
+function commandRequestsTapReporter(command) {
+  return (
+    (command?.executable === "NODE" &&
+      command.args?.[0] === "--test" &&
+      command.args?.[1] === "--test-reporter=tap") ||
+    (command?.executable === "NPM" &&
+      canonicalizeProjectJson(command.args) ===
+        canonicalizeProjectJson(["test"]))
+  );
+}
+
+async function validTestPlanCommand(command) {
+  const requiresTap = commandRequiresTapExpectation(command);
+  if (
+    !keysExactly(
+      command,
+      requiresTap
+        ? [
+            "commandId",
+            "executable",
+            "args",
+            "timeoutMs",
+            "testExpectation",
+          ]
+        : ["commandId", "executable", "args", "timeoutMs"],
+    ) ||
+    !COMMAND_ID.test(command?.commandId ?? "") ||
+    !["NODE", "NPM"].includes(command?.executable) ||
+    !Array.isArray(command?.args) ||
+    command.args.length === 0 ||
+    command.args.some(
+      (value) =>
+        typeof value !== "string" ||
+        value.length === 0 ||
+        value.includes("\u0000"),
+    ) ||
+    !Number.isInteger(command?.timeoutMs) ||
+    command.timeoutMs < 1000 ||
+    command.timeoutMs > 900000
+  ) {
+    return false;
+  }
+  return (
+    !requiresTap ||
+    (commandRequestsTapReporter(command) &&
+      (await validTapExpectation(command.testExpectation)))
+  );
+}
+
+function parseTapStructuralLine(line) {
+  const body = line.trimStart();
+  if (
+    body.startsWith("Bail out!") ||
+    /^TAP version(?:[ \t]|$)/u.test(body) ||
+    /^pragma(?:[ \t]|$)/u.test(body) ||
+    /^# (?:tests|suites|pass|fail|cancelled|skipped|todo|duration_ms)(?:[ \t]|$)/u.test(
+      body,
+    )
+  ) {
+    return { kind: "INVALID" };
+  }
+  const isStructural =
+    body.startsWith("# Subtest:") ||
+    /^(?:ok|not ok)(?:[ \t]|$)/u.test(body) ||
+    body.startsWith("1..");
+  if (!isStructural) return null;
+
+  const indentation = line.slice(0, line.length - body.length);
+  if (!/^ *$/u.test(indentation) || indentation.length % 4 !== 0) {
+    return { kind: "INVALID" };
+  }
+  const indent = indentation.length;
+  if (body.startsWith("# Subtest:")) {
+    const match = /^# Subtest: (.+)$/u.exec(body);
+    const name = match?.[1];
+    return typeof name === "string" &&
+      name.length <= 512 &&
+      !/[\u0000-\u001f]/u.test(name)
+      ? { kind: "SUBTEST", indent, name }
+      : { kind: "INVALID" };
+  }
+  const plan = /^1\.\.([0-9]+)$/u.exec(body);
+  if (plan !== null) {
+    const tests = Number(plan[1]);
+    return Number.isSafeInteger(tests) && tests <= 1_000_000
+      ? { kind: "PLAN", indent, tests }
+      : { kind: "INVALID" };
+  }
+  const resultLine = /^(ok|not ok) ([0-9]+) - (.+)$/u.exec(body);
+  if (resultLine === null) return { kind: "INVALID" };
+  const number = Number(resultLine[2]);
+  return Number.isSafeInteger(number) && number <= 1_000_000
+    ? {
+        kind: "RESULT",
+        indent,
+        status: resultLine[1],
+        number,
+        remainder: resultLine[3],
+      }
+    : { kind: "INVALID" };
+}
+
+function parseTapResult(resultLine, expectedNumber, subtestName) {
+  if (resultLine.number !== expectedNumber) return null;
+  let directive = null;
+  if (resultLine.remainder !== subtestName) {
+    const suffix = resultLine.remainder.slice(subtestName.length);
+    if (!resultLine.remainder.startsWith(subtestName)) return null;
+    const match = /^ # (SKIP|TODO|CANCELLED)(?: .+)?$/u.exec(suffix);
+    if (match === null) return null;
+    directive = match[1];
+  }
+  if (directive === "SKIP" && resultLine.status !== "ok") return null;
+  return {
+    name: subtestName,
+    outcome:
+      directive === "SKIP"
+        ? "skipped"
+        : directive === "TODO"
+          ? "todo"
+          : directive === "CANCELLED"
+            ? "cancelled"
+            : resultLine.status === "ok"
+              ? "pass"
+              : "fail",
+  };
+}
+
+function parseTapScope(lines, startIndex, indent) {
+  const points = [];
+  let index = startIndex;
+  let expectedNumber = 1;
+  while (index < lines.length) {
+    const structural = parseTapStructuralLine(lines[index]);
+    if (structural === null) {
+      index += 1;
+      continue;
+    }
+    if (structural.kind === "INVALID" || structural.indent !== indent) {
+      return null;
+    }
+    if (structural.kind === "PLAN") {
+      return structural.tests === expectedNumber - 1
+        ? { nextIndex: index + 1, points }
+        : null;
+    }
+    if (structural.kind !== "SUBTEST") return null;
+
+    const subtestName = structural.name;
+    const nestedPoints = [];
+    let nestedScopeSeen = false;
+    let resultSeen = false;
+    index += 1;
+    while (index < lines.length) {
+      const child = parseTapStructuralLine(lines[index]);
+      if (child === null) {
+        index += 1;
+        continue;
+      }
+      if (child.kind === "INVALID") return null;
+      if (
+        child.indent === indent + 4 &&
+        child.kind === "SUBTEST" &&
+        !nestedScopeSeen
+      ) {
+        const nestedScope = parseTapScope(lines, index, indent + 4);
+        if (nestedScope === null) return null;
+        nestedPoints.push(...nestedScope.points);
+        nestedScopeSeen = true;
+        index = nestedScope.nextIndex;
+        continue;
+      }
+      if (child.indent === indent && child.kind === "RESULT") {
+        const point = parseTapResult(
+          child,
+          expectedNumber,
+          subtestName,
+        );
+        if (point === null) return null;
+        points.push(...nestedPoints, point);
+        expectedNumber += 1;
+        resultSeen = true;
+        index += 1;
+        break;
+      }
+      return null;
+    }
+    if (!resultSeen) return null;
+  }
+  return null;
+}
+
+export async function parseIndependentReviewTapSummary(stdoutBytes) {
+  if (!(stdoutBytes instanceof Uint8Array)) return null;
+  let text;
+  try {
+    text = new TextDecoder("utf-8", { fatal: true }).decode(stdoutBytes);
+  } catch {
+    return null;
+  }
+  const lines = text.replace(/\r\n/gu, "\n").split("\n");
+  if (lines.at(-1) === "") lines.pop();
+  if (lines.some((line) => line.trimStart().startsWith("Bail out!"))) {
+    return null;
+  }
+  const tapHeaderIndexes = lines
+    .map((line, index) => (line === "TAP version 13" ? index : null))
+    .filter((value) => value !== null);
+  if (
+    tapHeaderIndexes.length !== 1 ||
+    lines
+      .slice(0, tapHeaderIndexes[0])
+      .some((line) => parseTapStructuralLine(line) !== null)
+  ) {
+    return null;
+  }
+  const parsed =
+    parseTapScope(lines, tapHeaderIndexes[0] + 1, 0);
+  const footer =
+    parsed === null ? [] : lines.slice(parsed.nextIndex);
+  if (
+    tapHeaderIndexes.length !== 1 ||
+    parsed === null ||
+    footer.length !== 8 ||
+    !/^# tests [0-9]+$/u.test(footer[0] ?? "") ||
+    !/^# suites [0-9]+$/u.test(footer[1] ?? "") ||
+    !/^# pass [0-9]+$/u.test(footer[2] ?? "") ||
+    !/^# fail [0-9]+$/u.test(footer[3] ?? "") ||
+    !/^# cancelled [0-9]+$/u.test(footer[4] ?? "") ||
+    !/^# skipped [0-9]+$/u.test(footer[5] ?? "") ||
+    !/^# todo [0-9]+$/u.test(footer[6] ?? "") ||
+    !/^# duration_ms [0-9]+(?:\.[0-9]+)?$/u.test(footer[7] ?? "")
+  ) {
+    return null;
+  }
+  const counts = {};
+  const footerIndexByField = {
+    tests: 0,
+    pass: 2,
+    fail: 3,
+    cancelled: 4,
+    skipped: 5,
+    todo: 6,
+  };
+  for (const field of TAP_COUNT_FIELDS) {
+    const match = new RegExp(`^# ${field} ([0-9]+)$`, "u").exec(
+      footer[footerIndexByField[field]],
+    );
+    if (match === null) return null;
+    counts[field] = Number(match[1]);
+    if (
+      !Number.isSafeInteger(counts[field]) ||
+      counts[field] < 0 ||
+      counts[field] > 1_000_000
+    ) {
+      return null;
+    }
+  }
+  const derivedCounts = {
+    tests: parsed.points.length,
+    pass: 0,
+    fail: 0,
+    cancelled: 0,
+    skipped: 0,
+    todo: 0,
+  };
+  for (const point of parsed.points) {
+    derivedCounts[point.outcome] += 1;
+  }
+  const skippedTestNames = sortedUtf8Strings(
+    parsed.points
+      .filter((point) => point.outcome === "skipped")
+      .map((point) => point.name),
+  );
+  if (
+    TAP_COUNT_FIELDS.some(
+      (field) => counts[field] !== derivedCounts[field],
+    ) ||
+    counts.tests !==
+      counts.pass +
+        counts.fail +
+        counts.cancelled +
+        counts.skipped +
+        counts.todo ||
+    skippedTestNames.length !== counts.skipped ||
+    !validTapTestNames(skippedTestNames)
+  ) {
+    return null;
+  }
+  return {
+    format: "NODE_TEST_TAP",
+    ...counts,
+    skippedTestNames,
+    skippedTestSetSha256: await sha256ProjectValue(skippedTestNames),
+  };
+}
+
+export async function tapSummaryMatchesExpectation(summary, expectation) {
+  return (
+    keysExactly(summary, TAP_SUMMARY_KEYS) &&
+    (await validTapExpectation(expectation)) &&
+    summary.format === expectation.format &&
+    TAP_COUNT_FIELDS.every(
+      (field) => summary[field] === expectation[field],
+    ) &&
+    validTapTestNames(summary.skippedTestNames) &&
+    summary.skippedTestSetSha256 ===
+      (await sha256ProjectValue(summary.skippedTestNames)) &&
+    canonicalizeProjectJson(summary.skippedTestNames) ===
+      canonicalizeProjectJson(expectation.allowedSkippedTestNames) &&
+    summary.skippedTestSetSha256 ===
+      expectation.allowedSkippedTestSetSha256
+  );
+}
+
+export async function assertIndependentReviewGitCollectionUnchanged(
+  frozenRefTips,
+  currentRefTips,
+) {
+  if (
+    !Array.isArray(frozenRefTips) ||
+    !Array.isArray(currentRefTips) ||
+    canonicalizeProjectJson(frozenRefTips) !==
+      canonicalizeProjectJson(currentRefTips)
+  ) {
+    throw new TypeError(
+      "Independent review ref-tip set changed during collection.",
+    );
+  }
+}
+
+export async function validateIndependentReviewTestPlan(plan) {
+  if (
+    !keysExactly(plan, [
+      "schemaVersion",
+      "planId",
+      "commands",
+      "planSha256",
+    ]) ||
