    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerProvider",
        "requestedModel",
        "actualReturnedModel",
        "apiBaseURL",
        "endpoint",
        "reviewerSessionId",
        "reviewerIndependentOfImplementation",
        "implementationProvider",
        "implementationModel",
        "diversityLevel"
      ],
      "properties": {
        "reviewerProvider": {
          "const": "moonshot"
        },
        "requestedModel": {
          "const": "kimi-k2.7-code"
        },
        "actualReturnedModel": {
          "const": "kimi-k2.7-code"
        },
        "apiBaseURL": {
