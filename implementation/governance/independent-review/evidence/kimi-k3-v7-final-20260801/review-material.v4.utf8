          "version",
          "integrity",
          "packageJsonSha256",
          "entryPath",
          "entrySha256",
          "entryCount",
          "totalByteLength",
          "manifestSha256",
        ]) &&
        contract.packageVersions[entry.name] === entry.version &&
        typeof entry.integrity === "string" &&
        entry.integrity.length > 0 &&
        SAFE_PATH.test(entry.entryPath ?? "") &&
        [
