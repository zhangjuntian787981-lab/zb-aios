    "artifacts",
    "contextAndBudget",
    "usage",
    "cost",
    "isolationEvidence",
    "reviewedPaths",
    "findings",
    "testEvidenceDigests",
    "decision",
    "conclusion",
    "historicalTerraEvidenceAccepted",
    "historicalK2EvidenceAccepted",
    "humanReviewClaim",
    "governanceEffect",
    "selfAuthorizing",
    "startedAt",
    "finishedAt",
    "recordedAt",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "independent-model-review-receipt.v8"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^imrr_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "receiptSchemaVersion": {
      "const": "independent-model-review-receipt.v8"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^imrr_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "policyVersion": {
      "const": "2.0.0-candidate.3"
    },
    "policySha256": {
      "$ref": "#/$defs/sha256"
    },
    "assuranceLevel": {
      "const": "MODEL_ONLY_PREPRODUCTION"
    },
    "applicablePhase": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "humanIndependentReviewSatisfied": {
      "const": false
    },
    "independentModelReviewRequired": {
      "const": true
    },
    "p3HumanReviewRequired": {
      "const": true
    },
    "bundleId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "bundleSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewMaterialSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerProvider",
        "requestedModel",
        "actualReturnedModel",
        "apiBaseURL",
        "endpoint",
        "reviewerSessionId",
        "reviewerIndependentOfImplementation",
        "implementationProvider",
        "implementationModel",
        "diversityLevel"
      ],
      "properties": {
        "reviewerProvider": {
          "const": "moonshot"
        },
        "requestedModel": {
          "const": "kimi-k3"
        },
        "actualReturnedModel": {
          "const": "kimi-k3"
        },
        "apiBaseURL": {
          "const": "https://api.moonshot.ai/v1"
        },
        "endpoint": {
          "const": "/chat/completions"
        },
        "reviewerSessionId": {
          "type": "string",
          "pattern": "^chatcmpl_[A-Za-z0-9_-]{8,255}$"
        },
        "reviewerIndependentOfImplementation": {
          "const": true
        },
        "implementationProvider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "implementationModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "diversityLevel": {
          "const": "DIFFERENT_MODEL_ID_DIFFERENT_PROVIDER"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
