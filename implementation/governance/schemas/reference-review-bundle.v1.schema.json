{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reference-review-bundle.v1.schema.json",
  "title": "Reference Review Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "bundlePath",
    "workPackageId",
    "reviewMode",
    "reviewBoundary",
    "applicableReferenceSetDigest",
    "referenceCatalogSha256",
    "referencePolicySha256",
    "profileSha256",
    "sourceCommit",
    "executionBaselineDigest",
    "candidateReferenceIds",
    "receipts",
    "zeroSetReason",
    "dependencyBindings",
    "implementationBindings",
    "governanceEffect",
    "isProgressTracker",
    "selfAuthorizing",
    "productionAdoptionClaim",
    "bundleSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reference-review-bundle.v1"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^rrb_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "bundlePath": {
      "type": "string",
      "minLength": 1
    },
    "workPackageId": {
      "type": "string",
      "pattern": "^(F|C|O|T)[0-9]{2}$"
    },
    "reviewMode": {
      "enum": [
        "PROSPECTIVE",
        "RETROSPECTIVE_BACKFILL"
      ]
    },
    "reviewBoundary": {
      "enum": [
        "PRE_START",
        "DEPENDENCY_ADOPTION",
        "IMPLEMENTATION_CONFORMANCE"
      ]
    },
    "applicableReferenceSetDigest": {
      "$ref": "#/$defs/sha256"
    },
    "referenceCatalogSha256": {
      "$ref": "#/$defs/sha256"
    },
    "referencePolicySha256": {
      "$ref": "#/$defs/sha256"
    },
    "profileSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "executionBaselineDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateReferenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R[0-9]{2}\\.[A-Z0-9][A-Z0-9_]{1,63}$"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceId",
          "path",
          "sha256",
          "decision",
          "adoptedArtifactDigest"
        ],
        "properties": {
          "referenceId": {
            "type": "string",
            "pattern": "^R[0-9]{2}\\.[A-Z0-9][A-Z0-9_]{1,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "decision": {
            "enum": [
              "ADOPT",
              "REJECT",
              "DEFER",
              "NOT_APPLICABLE"
            ]
          },
          "adoptedArtifactDigest": {
            "anyOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "zeroSetReason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "dependencyBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "referenceId",
          "version",
          "artifactDigest"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "pattern": "^O[0-9]{2}_[A-Z0-9_]{3,127}$"
          },
          "referenceId": {
            "type": "string",
            "pattern": "^R[0-9]{2}\\.[A-Z0-9][A-Z0-9_]{1,63}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "artifactDigest": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "implementationBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceId",
          "artifactDigest",
          "evidenceRef",
          "evidenceHash"
        ],
        "properties": {
          "referenceId": {
            "type": "string",
            "pattern": "^R[0-9]{2}\\.[A-Z0-9][A-Z0-9_]{1,63}$"
          },
          "artifactDigest": {
            "$ref": "#/$defs/sha256"
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1
          },
          "evidenceHash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "governanceEffect": {
      "const": "NONE"
    },
    "isProgressTracker": {
      "const": false
    },
    "selfAuthorizing": {
      "const": false
    },
    "productionAdoptionClaim": {
      "const": false
    },
    "bundleSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
