{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reference-applicability-evidence.v1.schema.json",
  "title": "Reference Applicability Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workPackageId",
    "sourceCommit",
    "candidateReferenceIds",
    "scans",
    "reviewedAt",
    "governanceEffect",
    "isProgressTracker",
    "selfAuthorizing",
    "productionAdoptionClaim",
    "reportSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reference-applicability-evidence.v1"
    },
    "workPackageId": {
      "$ref": "#/$defs/workPackageId"
    },
    "sourceCommit": {
      "$ref": "#/$defs/gitCommit"
    },
    "candidateReferenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/referenceId"
      }
    },
    "scans": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scanKind",
          "method",
          "methodVersion",
          "inputRefs",
          "inputHashes",
          "discoveredReferenceIds",
          "result"
        ],
        "properties": {
          "scanKind": {
            "enum": [
              "DEPENDENCY_LOCK_SCAN",
              "MANUAL_SUPPLEMENT",
              "REFERENCE_MATRIX",
              "SOURCE_INTEGRATION_SCAN"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "methodVersion": {
            "type": "string",
            "minLength": 1
          },
          "inputRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/$defs/path"
            }
          },
          "inputHashes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/$defs/sha256"
            }
          },
          "discoveredReferenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/referenceId"
            }
          },
          "result": {
            "const": "COMPLETE"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "scanKind": {
                  "const": "DEPENDENCY_LOCK_SCAN"
                }
              }
            },
            "then": {
              "properties": {
                "method": {
                  "const": "deterministic-dependency-lock-parser"
                },
                "methodVersion": {
                  "const": "v1"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scanKind": {
                  "const": "MANUAL_SUPPLEMENT"
                }
              }
            },
            "then": {
              "properties": {
                "method": {
                  "const": "deterministic-manual-supplement-parser"
                },
                "methodVersion": {
                  "const": "v1"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scanKind": {
                  "const": "REFERENCE_MATRIX"
                }
              }
            },
            "then": {
              "properties": {
                "method": {
                  "const": "deterministic-reference-matrix-parser"
                },
                "methodVersion": {
                  "const": "v1"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scanKind": {
                  "const": "SOURCE_INTEGRATION_SCAN"
                }
              }
            },
            "then": {
              "properties": {
                "method": {
                  "const": "deterministic-source-integration-parser"
                },
                "methodVersion": {
                  "const": "v1"
                }
              }
            }
          }
        ]
      }
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "governanceEffect": {
      "const": "NONE"
    },
    "isProgressTracker": {
      "const": false
    },
    "selfAuthorizing": {
      "const": false
    },
    "productionAdoptionClaim": {
      "const": false
    },
    "reportSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "workPackageId": {
      "type": "string",
      "pattern": "^(F|C|O|T)[0-9]{2}$"
    },
    "referenceId": {
      "type": "string",
      "pattern": "^R[0-9]{2}\\.[A-Z0-9][A-Z0-9_]{1,63}$"
    }
  }
}
