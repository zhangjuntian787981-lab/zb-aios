{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-review-test-result.v2.schema.json",
  "title": "Independent Review Test Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "testPlanSha256",
    "sourceCommit",
    "sourceTree",
    "runner",
    "executionSource",
    "commandId",
    "argvSha256",
    "observation",
    "stdoutRef",
    "stdoutSha256",
    "stdoutByteLength",
    "stderrRef",
    "stderrSha256",
    "stderrByteLength",
    "resultSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "independent-review-test-result.v2"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "testPlanSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "sourceTree": {
      "$ref": "#/$defs/commit"
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "gitBlobSha256",
        "executedBytesSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "gitBlobSha256": {
          "$ref": "#/$defs/sha256"
        },
        "executedBytesSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "before",
        "after",
        "unchanged"
      ],
      "properties": {
        "mode": {
          "const": "ISOLATED_LOCAL_CLONE"
        },
        "before": {
          "$ref": "#/$defs/executionSnapshot"
        },
        "after": {
          "$ref": "#/$defs/executionSnapshot"
        },
        "unchanged": {
          "const": true
        }
      }
    },
    "commandId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "argvSha256": {
      "$ref": "#/$defs/sha256"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "signal",
        "timedOut",
        "startedAt",
        "finishedAt"
      ],
      "properties": {
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "signal": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "timedOut": {
          "type": "boolean"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stdoutRef": {
      "$ref": "#/$defs/path"
    },
    "stdoutSha256": {
      "$ref": "#/$defs/sha256"
    },
    "stdoutByteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "stderrRef": {
      "$ref": "#/$defs/path"
    },
    "stderrSha256": {
      "$ref": "#/$defs/sha256"
    },
    "stderrByteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "resultSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    },
    "executionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "tree",
        "worktreeStatusSha256"
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/commit"
        },
        "tree": {
          "$ref": "#/$defs/commit"
        },
        "worktreeStatusSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
