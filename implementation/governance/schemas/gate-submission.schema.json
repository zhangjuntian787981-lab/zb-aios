{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-platform/gate-submission.schema.json",
  "title": "GateSubmission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "submission_id",
    "package_hash",
    "submitted_at",
    "submitted_by",
    "source_revision",
    "work_package_scope",
    "evidence_refs",
    "supersedes"
  ],
  "properties": {
    "gate_id": {
      "enum": ["G0", "G1", "G2", "G3"]
    },
    "submission_id": {
      "type": "string",
      "minLength": 1
    },
    "package_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_by": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "integer",
      "minimum": 0
    },
    "work_package_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": ["string", "null"]
    }
  }
}
