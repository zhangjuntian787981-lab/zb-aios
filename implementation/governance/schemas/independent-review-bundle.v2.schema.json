{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-review-bundle.v2.schema.json",
  "title": "Independent Review Bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "lifecycle",
    "assuranceLevel",
    "applicablePhase",
    "dataBoundary",
    "enterpriseDataUsed",
    "productionEffect",
    "policy",
    "artifacts",
    "source",
    "repositoryProtection",
    "reviewedPaths",
    "sourceSubjects",
    "specificationSubjects",
    "testEvidenceSubjects",
    "implementationIdentity",
    "requiredRuntimeConstraints",
    "governanceBoundary",
    "generatedAt",
    "bundleSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "independent-review-bundle.v2"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "lifecycle": {
      "const": "CANDIDATE"
    },
    "assuranceLevel": {
      "const": "MODEL_ONLY_PREPRODUCTION"
    },
    "applicablePhase": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "dataBoundary": {
      "const": "SYNTHETIC_ONLY"
    },
    "enterpriseDataUsed": {
      "const": false
    },
    "productionEffect": {
      "const": false
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "version": {
          "const": "2.0.0-candidate.3"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policySchemaPath",
        "policySchemaSha256",
        "bundleSchemaPath",
        "bundleSchemaSha256",
        "receiptSchemaPath",
        "receiptSchemaSha256",
        "outputSchemaPath",
        "outputSchemaSha256",
        "runtimeEvidenceSchemaPath",
        "runtimeEvidenceSchemaSha256",
        "transportEvidenceSchemaPath",
        "transportEvidenceSchemaSha256",
        "testResultSchemaPath",
        "testResultSchemaSha256",
        "semanticValidatorPath",
        "semanticValidatorSha256",
        "independenceValidatorPath",
        "independenceValidatorSha256",
        "runtimeEvidenceValidatorPath",
        "runtimeEvidenceValidatorSha256",
        "transportEvidenceValidatorPath",
        "transportEvidenceValidatorSha256",
        "checkMapperPath",
        "checkMapperSha256",
        "bundleGeneratorPath",
        "bundleGeneratorSha256",
        "testPlanPath",
        "testPlanSha256",
        "testEvidenceCollectorPath",
        "testEvidenceCollectorSha256",
        "runtimeControlPlanePath",
        "runtimeControlPlaneSha256",
        "sandboxPolicyTemplatePath",
        "sandboxPolicyTemplateSha256",
        "promptPath",
        "promptSha256"
      ],
      "properties": {
        "policySchemaPath": {
          "$ref": "#/$defs/path"
        },
        "policySchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "bundleSchemaPath": {
          "$ref": "#/$defs/path"
        },
        "bundleSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "receiptSchemaPath": {
          "$ref": "#/$defs/path"
        },
        "receiptSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outputSchemaPath": {
          "$ref": "#/$defs/path"
        },
        "outputSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtimeEvidenceSchemaPath": {
          "$ref": "#/$defs/path"
        },
        "runtimeEvidenceSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "transportEvidenceSchemaPath": {
          "$ref": "#/$defs/path"
        },
        "transportEvidenceSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "testResultSchemaPath": {
          "$ref": "#/$defs/path"
        },
        "testResultSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "semanticValidatorPath": {
          "$ref": "#/$defs/path"
        },
        "semanticValidatorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "independenceValidatorPath": {
          "$ref": "#/$defs/path"
        },
        "independenceValidatorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtimeEvidenceValidatorPath": {
          "$ref": "#/$defs/path"
        },
        "runtimeEvidenceValidatorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "transportEvidenceValidatorPath": {
          "$ref": "#/$defs/path"
        },
        "transportEvidenceValidatorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "checkMapperPath": {
          "$ref": "#/$defs/path"
        },
        "checkMapperSha256": {
          "$ref": "#/$defs/sha256"
        },
        "bundleGeneratorPath": {
          "$ref": "#/$defs/path"
        },
        "bundleGeneratorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "testPlanPath": {
          "$ref": "#/$defs/path"
        },
        "testPlanSha256": {
          "$ref": "#/$defs/sha256"
        },
        "testEvidenceCollectorPath": {
          "$ref": "#/$defs/path"
        },
        "testEvidenceCollectorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtimeControlPlanePath": {
          "$ref": "#/$defs/path"
        },
        "runtimeControlPlaneSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sandboxPolicyTemplatePath": {
          "$ref": "#/$defs/path"
        },
        "sandboxPolicyTemplateSha256": {
          "$ref": "#/$defs/sha256"
        },
        "promptPath": {
          "$ref": "#/$defs/path"
        },
        "promptSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCommit",
        "sourceCommit",
        "headCommit",
        "tree",
        "diffSha256",
        "changedPathsDigest",
        "gitDiffCheck"
      ],
      "properties": {
        "baseCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "headCommit": {
          "$ref": "#/$defs/commit"
        },
        "tree": {
          "$ref": "#/$defs/commit"
        },
        "diffSha256": {
          "$ref": "#/$defs/sha256"
        },
        "changedPathsDigest": {
          "$ref": "#/$defs/sha256"
        },
        "gitDiffCheck": {
          "$ref": "#/$defs/gitDiffCheck"
        }
      }
    },
    "repositoryProtection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protectedPaths",
        "protectedPathSetSha256"
      ],
      "properties": {
        "protectedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "protectedPathSetSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "sourceSubjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "gitMode",
          "blobSha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "gitMode": {
            "type": "string",
            "pattern": "^(100644|100755|120000|160000)$"
          },
          "blobSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "specificationSubjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/pathDigest"
      }
    },
    "testEvidenceSubjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceId",
          "command",
          "status",
          "exitCode",
          "outputRef",
          "outputSha256",
          "outputByteLength",
          "truncated",
          "sourceCommit",
          "runner",
          "toolVersions"
        ],
        "properties": {
          "evidenceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "status": {
            "const": "PASS"
          },
          "exitCode": {
            "const": 0
          },
          "outputRef": {
            "$ref": "#/$defs/path"
          },
          "outputSha256": {
            "$ref": "#/$defs/sha256"
          },
          "outputByteLength": {
            "type": "integer",
            "minimum": 1
          },
          "truncated": {
            "const": false
          },
          "sourceCommit": {
            "$ref": "#/$defs/commit"
          },
          "runner": {
            "const": "GIT_FROZEN_ARCHIVE_READONLY_CONTROL_PLANE"
          },
          "toolVersions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128
            }
          }
        }
      }
    },
    "implementationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId",
        "modelVersion",
        "participantManifestSha256",
        "sessionIdSha256"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "participantManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sessionIdSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requiredRuntimeConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "differentModelIdRequired",
        "differentProviderOrFamilyPreferred",
        "freshIsolatedContextRequired",
        "fullImplementationHistoryAllowed",
        "implementationParticipationAllowed",
        "allowedInputsOnly",
        "promptInjectionTreatedAsData",
        "approvedIsolationModes",
        "reviewMaterialAccess",
        "runtimeScratchPolicy",
        "ephemeral",
        "forbiddenCapabilities"
      ],
      "properties": {
        "differentModelIdRequired": {
          "const": true
        },
        "differentProviderOrFamilyPreferred": {
          "const": true
        },
        "freshIsolatedContextRequired": {
          "const": true
        },
        "fullImplementationHistoryAllowed": {
          "const": false
        },
        "implementationParticipationAllowed": {
          "const": false
        },
        "allowedInputsOnly": {
          "const": true
        },
        "promptInjectionTreatedAsData": {
          "const": true
        },
        "approvedIsolationModes": {
          "const": [
            "API_NO_TOOLS",
            "OS_ENFORCED_TARGET_READ_ONLY"
          ]
        },
        "reviewMaterialAccess": {
          "const": "EXACT_HASH_BOUND_BUNDLE_READ_ONLY"
        },
        "runtimeScratchPolicy": {
          "const": "ISOLATED_NON_GOVERNANCE_SCRATCH_ONLY"
        },
        "ephemeral": {
          "const": true
        },
        "forbiddenCapabilities": {
          "const": [
            "COMMIT",
            "D1_WRITE",
            "DEPLOY",
            "FILE_WRITE",
            "GOVERNANCE_DECISION",
            "PUSH"
          ]
        }
      }
    },
    "governanceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governanceEffect",
        "isProgressTracker",
        "selfAuthorizing",
        "humanIndependentReviewSatisfied",
        "remoteCheckPublished",
        "p1B11StatusChanged"
      ],
      "properties": {
        "governanceEffect": {
          "const": "NONE"
        },
        "isProgressTracker": {
          "const": false
        },
        "selfAuthorizing": {
          "const": false
        },
        "humanIndependentReviewSatisfied": {
          "const": false
        },
        "remoteCheckPublished": {
          "const": false
        },
        "p1B11StatusChanged": {
          "const": false
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "bundleSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitDiffCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "checkId",
        "executionMode",
        "baseCommit",
        "sourceCommit",
        "sourceTree",
        "checkedPatchSha256",
        "runnerPath",
        "runnerGitBlobSha256",
        "runnerExecutedBytesSha256",
        "gitExecutable",
        "gitVersion",
        "logicalCommandSha256",
        "environmentSha256",
        "exitCode",
        "status",
        "stdoutSha256",
        "stdoutByteLength",
        "stderrSha256",
        "stderrByteLength",
        "resultSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": "independent-review-git-diff-check.v1"
        },
        "checkId": {
          "const": "base-to-source-diff-check"
        },
        "executionMode": {
          "const": "TRUSTED_GIT_OBJECT_DATABASE_CONTROL_PLANE"
        },
        "baseCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceTree": {
          "$ref": "#/$defs/commit"
        },
        "checkedPatchSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnerPath": {
          "$ref": "#/$defs/path"
        },
        "runnerGitBlobSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnerExecutedBytesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "gitExecutable": {
          "const": "/usr/bin/git"
        },
        "gitVersion": {
          "type": "string",
          "pattern": "^git version [^\\r\\n]{1,128}$"
        },
        "logicalCommandSha256": {
          "$ref": "#/$defs/sha256"
        },
        "environmentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "exitCode": {
          "const": 0
        },
        "status": {
          "const": "PASS"
        },
        "stdoutSha256": {
          "const": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "stdoutByteLength": {
          "const": 0
        },
        "stderrSha256": {
          "const": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        },
        "stderrByteLength": {
          "const": 0
        },
        "resultSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    },
    "pathDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blobSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "blobSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
