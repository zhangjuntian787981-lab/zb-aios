{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://zb-aios.local/schemas/independent-model-review-output.v3.schema.json","title":"Independent Model Review Output v3","type":"object","additionalProperties":false,"required":["schemaVersion","reviewBinding","coverage","reviewSummary","findings","decision"],"properties":{"schemaVersion":{"const":"independent-model-review-output.v3"},"reviewBinding":{"type":"object","additionalProperties":false,"required":["sourceCommit","sourceTree","materialSha256","envelopeSha256"],"properties":{"sourceCommit":{"$ref":"#/$defs/commit"},"sourceTree":{"$ref":"#/$defs/commit"},"materialSha256":{"$ref":"#/$defs/sha256"},"envelopeSha256":{"$ref":"#/$defs/sha256"}}},"coverage":{"type":"object","additionalProperties":false,"required":["coverageMode","verbatimFullFileManifestSha256","verbatimPatchManifestSha256","digestOnlyManifestSha256","digestOnlyNotByteReviewed"],"properties":{"coverageMode":{"const":"MIXED_VERBATIM_PATCH_AND_GIT_DIGEST_ONLY"},"verbatimFullFileManifestSha256":{"$ref":"#/$defs/sha256"},"verbatimPatchManifestSha256":{"$ref":"#/$defs/sha256"},"digestOnlyManifestSha256":{"$ref":"#/$defs/sha256"},"digestOnlyNotByteReviewed":{"const":true}}},"reviewSummary":{"type":"string","minLength":1,"maxLength":4000},"findings":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/finding"}},"decision":{"enum":["CLEAR","BLOCKED","INCONCLUSIVE"]}},"$defs":{"commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"line":{"type":["integer","null"],"minimum":1},"finding":{"type":"object","additionalProperties":false,"required":["findingId","severity","status","evidenceMode","evidenceDigest","path","lineSide","startLine","endLine","summary","detailsSha256","resolutionEvidenceDigests"],"properties":{"findingId":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{2,127}$"},"severity":{"enum":["INFO","LOW","MEDIUM","HIGH","CRITICAL"]},"status":{"enum":["OPEN","RESOLVED"]