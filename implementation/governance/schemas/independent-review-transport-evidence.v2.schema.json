{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-review-transport-evidence.v2.schema.json",
  "title": "Independent Review Transport Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "provider",
    "requestedModel",
    "actualReturnedModel",
    "responseId",
    "baseURL",
    "endpoint",
    "source",
    "bindings",
    "request",
    "response",
    "content",
    "protocol",
    "usage",
    "cost",
    "validators",
    "startedAt",
    "finishedAt",
    "transportEvidenceSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "independent-review-transport-evidence.v2"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^irte_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "provider": {
      "const": "moonshot"
    },
    "requestedModel": {
      "const": "kimi-k3"
    },
    "actualReturnedModel": {
      "const": "kimi-k3"
    },
    "responseId": {
      "type": "string",
      "pattern": "^chatcmpl_[A-Za-z0-9_-]{8,255}$"
    },
    "baseURL": {
      "const": "https://api.moonshot.ai/v1"
    },
    "endpoint": {
      "const": "/chat/completions"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "sourceTree"
      ],
      "properties": {
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceTree": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewBundleSha256",
        "reviewerPromptSha256",
        "receiptSchemaSha256",
        "outputSchemaPath",
        "outputSchemaSha256",
        "providerConfigSha256",
        "tokenEstimateEvidenceSha256"
      ],
      "properties": {
        "reviewBundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewerPromptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "receiptSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outputSchemaPath": {
          "$ref": "#/$defs/path"
        },
        "outputSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "providerConfigSha256": {
          "$ref": "#/$defs/sha256"
        },
        "tokenEstimateEvidenceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "request": {
      "$ref": "#/$defs/byteArtifact"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "encoding",
        "byteLength",
        "sha256",
        "httpStatus",
        "contentType"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "encoding": {
          "const": "UTF-8"
        },
        "byteLength": {
          "$ref": "#/$defs/byteLength"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "httpStatus": {
          "const": 200
        },
        "contentType": {
          "type": "string",
          "pattern": "^application/json(?:;\\s*charset=utf-8)?$",
          "maxLength": 64
        }
      }
    },
    "content": {
      "$ref": "#/$defs/byteArtifact"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolsAbsent",
        "toolChoiceNone",
        "thinkingAbsent",
        "reasoningEffort",
        "strictSchema",
        "maxCompletionTokens",
        "networkAttemptCount",
        "choiceCount",
        "finishReason"
      ],
      "properties": {
        "toolsAbsent": {
          "const": true
        },
        "toolChoiceNone": {
          "const": true
        },
        "thinkingAbsent": {
          "const": true
        },
        "reasoningEffort": {
          "const": "max"
        },
        "strictSchema": {
          "const": true
        },
        "maxCompletionTokens": {
          "const": 32768
        },
        "networkAttemptCount": {
          "const": 1
        },
        "choiceCount": {
          "const": 1
        },
        "finishReason": {
          "const": "stop"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptTokens",
        "completionTokens",
        "totalTokens",
        "cachedTokens"
      ],
      "properties": {
        "promptTokens": {
          "$ref": "#/$defs/tokenCount"
        },
        "completionTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "totalTokens": {
          "$ref": "#/$defs/tokenCount"
        },
        "cachedTokens": {
          "$ref": "#/$defs/tokenCount"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "taxBasis",
        "inputMicros",
        "outputMicros",
        "totalMicros",
        "budgetMicros",
        "withinBudget"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "taxBasis": {
          "const": "TAX_EXCLUSIVE"
        },
        "inputMicros": {
          "$ref": "#/$defs/micros"
        },
        "outputMicros": {
          "$ref": "#/$defs/micros"
        },
        "totalMicros": {
          "$ref": "#/$defs/micros"
        },
        "budgetMicros": {
          "const": 4000000
        },
        "withinBudget": {
          "const": true
        }
      }
    },
    "validators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaValidatorVersion",
        "semanticValidatorVersion"
      ],
      "properties": {
        "schemaValidatorVersion": {
          "$ref": "#/$defs/version"
        },
        "semanticValidatorVersion": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "transportEvidenceSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:/+-]{0,127}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1572864
    },
    "byteArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "encoding",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "encoding": {
          "const": "UTF-8"
        },
        "byteLength": {
          "$ref": "#/$defs/byteLength"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "tokenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "micros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    }
  }
}
