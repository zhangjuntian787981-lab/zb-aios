{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-review-segment-material.v1.schema.json",
  "title": "Kimi Segment Review Material v1 Header",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "materialId", "segmentPlanSha256", "source", "bindings", "segment", "bindingSections", "commonSections", "reviewedSections", "payloadOrder", "payloadUtf8ByteLength", "executionAuthorization", "materialSha256"],
  "properties": {
    "schemaVersion": { "const": "kimi-segment-review-material.v1" },
    "materialId": { "type": "string", "minLength": 8, "maxLength": 256 },
    "segmentPlanSha256": { "$ref": "#/$defs/sha256" },
    "source": { "$ref": "#/$defs/source" },
    "bindings": { "$ref": "#/$defs/bindings" },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["segmentId", "ordinal", "semanticScope", "pathSetSha256"],
      "properties": { "segmentId": { "$ref": "#/$defs/segmentId" }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 4 }, "semanticScope": { "type": "string", "minLength": 8, "maxLength": 128 }, "pathSetSha256": { "$ref": "#/$defs/sha256" } }
    },
    "bindingSections": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/bindingSection" } },
    "commonSections": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/commonSection" } },
    "reviewedSections": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/reviewedSection" } },
    "payloadOrder": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "$ref": "#/$defs/payload" } },
    "payloadUtf8ByteLength": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "executionAuthorization": { "const": "LOCAL_MATERIALIZATION_ONLY_NO_NETWORK" },
    "materialSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$" }, "segmentId": { "enum": ["GOVERNANCE_LINEAGE", "SCHEMAS_WIRE_CONTRACTS", "RUNTIME_ORCHESTRATION", "TESTS_VERIFICATION"] },
    "source": { "type": "object", "additionalProperties": false, "required": ["baseCommit", "sourceCommit", "headCommit", "tree", "diffSha256", "changedPathsDigest"], "properties": { "baseCommit": { "$ref": "#/$defs/commit" }, "sourceCommit": { "$ref": "#/$defs/commit" }, "headCommit": { "$ref": "#/$defs/commit" }, "tree": { "$ref": "#/$defs/commit" }, "diffSha256": { "$ref": "#/$defs/sha256" }, "changedPathsDigest": { "$ref": "#/$defs/sha256" } } },
    "descriptor": { "type": "object", "additionalProperties": false, "required": ["path", "byteLength", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "bindings": { "type": "object", "additionalProperties": false, "required": ["reviewBundle", "segmentReviewerPrompt", "integrationReviewerPrompt", "canonicalOutputSchema", "providerTransportSchema", "providerConfig", "providerConfigSchema", "tokenEstimateEvidenceSchema", "segmentedTransportEvidenceSchema", "segmentReceiptSchema", "integrationReceiptSchema", "aggregateReceiptSchema"], "properties": { "reviewBundle": { "$ref": "#/$defs/descriptor" }, "segmentReviewerPrompt": { "$ref": "#/$defs/descriptor" }, "integrationReviewerPrompt": { "$ref": "#/$defs/descriptor" }, "canonicalOutputSchema": { "$ref": "#/$defs/descriptor" }, "providerTransportSchema": { "$ref": "#/$defs/descriptor" }, "providerConfig": { "$ref": "#/$defs/descriptor" }, "providerConfigSchema": { "$ref": "#/$defs/descriptor" }, "tokenEstimateEvidenceSchema": { "$ref": "#/$defs/descriptor" }, "segmentedTransportEvidenceSchema": { "$ref": "#/$defs/descriptor" }, "segmentReceiptSchema": { "$ref": "#/$defs/descriptor" }, "integrationReceiptSchema": { "$ref": "#/$defs/descriptor" }, "aggregateReceiptSchema": { "$ref": "#/$defs/descriptor" } } },
    "bindingSection": { "type": "object", "additionalProperties": false, "required": ["binding", "kind", "path", "byteLength", "sha256"], "properties": { "binding": { "enum": ["reviewBundle", "segmentReviewerPrompt", "integrationReviewerPrompt", "canonicalOutputSchema", "providerTransportSchema", "providerConfig", "providerConfigSchema", "tokenEstimateEvidenceSchema", "segmentedTransportEvidenceSchema", "segmentReceiptSchema", "integrationReceiptSchema", "aggregateReceiptSchema"] }, "kind": { "enum": ["GOVERNANCE", "REVIEW_BUNDLE", "SPECIFICATION"] }, "path": { "$ref": "#/$defs/path" }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "commonSection": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "byteLength", "sha256"], "properties": { "kind": { "enum": ["GOVERNANCE", "SPECIFICATION", "TEST_EVIDENCE"] }, "path": { "$ref": "#/$defs/path" }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "reviewedSection": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "gitMode", "byteLength", "sha256"], "properties": { "kind": { "const": "SOURCE" }, "path": { "$ref": "#/$defs/path" }, "gitMode": { "enum": ["100644", "100755"] }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "payload": { "type": "object", "additionalProperties": false, "required": ["scope", "index", "path", "byteLength", "sha256"], "properties": { "scope": { "enum": ["BINDING", "COMMON", "REVIEWED"] }, "index": { "type": "integer", "minimum": 0, "maximum": 8191 }, "path": { "$ref": "#/$defs/path" }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
