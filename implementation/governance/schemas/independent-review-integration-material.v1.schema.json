{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://zb-aios.local/schemas/independent-review-integration-material.v1.schema.json", "title": "Kimi Cross-Cutting Integration Material v1 Header",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "materialId", "segmentPlanSha256", "source", "bindings", "segmentReceiptBindings", "fullPatch", "bundlePathInventoryDigest", "integrationSections", "payloadOrder", "payloadUtf8ByteLength", "pathOwnershipEffect", "executionAuthorization", "materialSha256"],
  "properties": {
    "schemaVersion": { "const": "kimi-cross-cutting-integration-material.v1" }, "materialId": { "type": "string", "minLength": 8, "maxLength": 256 }, "segmentPlanSha256": { "$ref": "#/$defs/sha256" }, "source": { "$ref": "#/$defs/source" }, "bindings": { "$ref": "#/$defs/bindings" }, "segmentReceiptBindings": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/receiptBinding" } }, "fullPatch": { "$ref": "#/$defs/descriptor" }, "bundlePathInventoryDigest": { "$ref": "#/$defs/sha256" }, "integrationSections": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/commonSection" } }, "payloadOrder": { "type": "array", "minItems": 14, "maxItems": 8192, "items": { "$ref": "#/$defs/payload" } }, "payloadUtf8ByteLength": { "type": "integer", "minimum": 0, "maximum": 2147483647 }, "pathOwnershipEffect": { "const": "NONE_REPEATED_READING_DOES_NOT_CHANGE_OWNERSHIP" }, "executionAuthorization": { "const": "LOCAL_MATERIALIZATION_ONLY_NO_NETWORK" }, "materialSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$" },
    "source": { "type": "object", "additionalProperties": false, "required": ["baseCommit", "sourceCommit", "headCommit", "tree", "diffSha256", "changedPathsDigest"], "properties": { "baseCommit": { "$ref": "#/$defs/commit" }, "sourceCommit": { "$ref": "#/$defs/commit" }, "headCommit": { "$ref": "#/$defs/commit" }, "tree": { "$ref": "#/$defs/commit" }, "diffSha256": { "$ref": "#/$defs/sha256" }, "changedPathsDigest": { "$ref": "#/$defs/sha256" } } },
    "descriptor": { "type": "object", "additionalProperties": false, "required": ["path", "byteLength", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "bindings": { "type": "object", "additionalProperties": false, "required": ["reviewBundle", "segmentReviewerPrompt", "integrationReviewerPrompt", "canonicalOutputSchema", "providerTransportSchema", "providerConfig", "providerConfigSchema", "tokenEstimateEvidenceSchema", "segmentedTransportEvidenceSchema", "segmentReceiptSchema", "integrationReceiptSchema", "aggregateReceiptSchema"], "properties": { "reviewBundle": { "$ref": "#/$defs/descriptor" }, "segmentReviewerPrompt": { "$ref": "#/$defs/descriptor" }, "integrationReviewerPrompt": { "$ref": "#/$defs/descriptor" }, "canonicalOutputSchema": { "$ref": "#/$defs/descriptor" }, "providerTransportSchema": { "$ref": "#/$defs/descriptor" }, "providerConfig": { "$ref": "#/$defs/descriptor" }, "providerConfigSchema": { "$ref": "#/$defs/descriptor" }, "tokenEstimateEvidenceSchema": { "$ref": "#/$defs/descriptor" }, "segmentedTransportEvidenceSchema": { "$ref": "#/$defs/descriptor" }, "segmentReceiptSchema": { "$ref": "#/$defs/descriptor" }, "integrationReceiptSchema": { "$ref": "#/$defs/descriptor" }, "aggregateReceiptSchema": { "$ref": "#/$defs/descriptor" } } },
    "receiptBinding": { "type": "object", "additionalProperties": false, "required": ["receiptId", "segmentId", "decision", "receiptSha256", "byteLength", "bytesSha256"], "properties": { "receiptId": { "type": "string", "minLength": 8, "maxLength": 160 }, "segmentId": { "enum": ["GOVERNANCE_LINEAGE", "SCHEMAS_WIRE_CONTRACTS", "RUNTIME_ORCHESTRATION", "TESTS_VERIFICATION"] }, "decision": { "enum": ["CLEAR", "BLOCKED", "INCONCLUSIVE"] }, "receiptSha256": { "$ref": "#/$defs/sha256" }, "byteLength": { "type": "integer", "minimum": 1, "maximum": 1048576 }, "bytesSha256": { "$ref": "#/$defs/sha256" } } },
    "commonSection": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "byteLength", "sha256"], "properties": { "kind": { "enum": ["GOVERNANCE", "SPECIFICATION", "TEST_EVIDENCE"] }, "path": { "$ref": "#/$defs/path" }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "payload": { "type": "object", "additionalProperties": false, "required": ["scope", "index", "path", "byteLength", "sha256"], "properties": { "scope": { "enum": ["BINDING", "SEGMENT_RECEIPT", "FULL_PATCH", "INTEGRATION_CONTRACT"] }, "index": { "type": "integer", "minimum": 0, "maximum": 8191 }, "path": { "$ref": "#/$defs/path" }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
