{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-review-transport-evidence.v1.schema.json",
  "title": "Independent Review Transport Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "provider",
    "requestedModel",
    "actualReturnedModel",
    "baseURL",
    "endpoint",
    "source",
    "bindings",
    "request",
    "response",
    "content",
    "protocol",
    "validators",
    "startedAt",
    "finishedAt",
    "transportEvidenceSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "independent-review-transport-evidence.v1"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^irte_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "provider": {
      "$ref": "#/$defs/name"
    },
    "requestedModel": {
      "$ref": "#/$defs/name"
    },
    "actualReturnedModel": {
      "$ref": "#/$defs/name"
    },
    "baseURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?![^/@\\s]+@)[^\\s?#]+$",
      "maxLength": 512
    },
    "endpoint": {
      "type": "string",
      "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\?#]{1,511}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "sourceTree"
      ],
      "properties": {
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceTree": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewBundleSha256",
        "reviewerPromptSha256",
        "receiptSchemaSha256",
        "outputSchemaPath",
        "outputSchemaSha256"
      ],
      "properties": {
        "reviewBundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewerPromptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "receiptSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outputSchemaPath": {
          "$ref": "#/$defs/path"
        },
        "outputSchemaSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "request": {
      "$ref": "#/$defs/byteBinding"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "encoding",
        "byteLength",
        "sha256",
        "httpStatus",
        "contentType"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "encoding": {
          "const": "UTF-8"
        },
        "byteLength": {
          "$ref": "#/$defs/byteLength"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "httpStatus": {
          "const": 200
        },
        "contentType": {
          "type": "string",
          "pattern": "^application/json(?:;\\s*charset=utf-8)?$",
          "maxLength": 64
        }
      }
    },
    "content": {
      "$ref": "#/$defs/byteBinding"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolsAbsent",
        "toolChoiceNone",
        "strictSchema",
        "networkAttemptCount",
        "choiceCount",
        "finishReason"
      ],
      "properties": {
        "toolsAbsent": {
          "const": true
        },
        "toolChoiceNone": {
          "const": true
        },
        "strictSchema": {
          "const": true
        },
        "networkAttemptCount": {
          "const": 1
        },
        "choiceCount": {
          "const": 1
        },
        "finishReason": {
          "const": "stop"
        }
      }
    },
    "validators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaValidatorVersion",
        "semanticValidatorVersion"
      ],
      "properties": {
        "schemaValidatorVersion": {
          "$ref": "#/$defs/version"
        },
        "semanticValidatorVersion": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "transportEvidenceSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:/+-]{0,127}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "byteBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "encoding",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "encoding": {
          "const": "UTF-8"
        },
        "byteLength": {
          "$ref": "#/$defs/byteLength"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
