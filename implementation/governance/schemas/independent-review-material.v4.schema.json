{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-review-material.v4.schema.json",
  "title": "Independent review material v4 envelope manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "materialId",
    "source",
    "bindings",
    "sections",
    "priorReviewEvidenceReferences",
    "sectionSetSha256",
    "priorReviewEvidenceReferenceSetSha256",
    "reviewedPathCoverageSha256",
    "totalSectionUtf8ByteLength",
    "contextBudgetUtf8Bytes",
    "resourceCeilingBasis",
    "materialSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "independent-review-material.v4"
    },
    "materialId": {
      "type": "string",
      "pattern": "^irm_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCommit",
        "sourceCommit",
        "sourceTree",
        "patchSha256",
        "gitDiffCheckSha256"
      ],
      "properties": {
        "baseCommit": {
          "const": "ab95c7aff586279062c7698749fdbc0e38e955d1"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceTree": {
          "$ref": "#/$defs/commit"
        },
        "patchSha256": {
          "$ref": "#/$defs/sha256"
        },
        "gitDiffCheckSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewBundle",
        "reviewerPrompt",
        "canonicalOutputSchema",
        "canonicalReceiptSchema",
        "providerConfig",
        "historicalEvidenceIndex",
        "historicalEvidenceIndexSchema"
      ],
      "properties": {
        "reviewBundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "byteLength",
            "sha256",
            "bundleDigest"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "byteLength": {
              "$ref": "#/$defs/byteLength"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bundleDigest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "reviewerPrompt": {
          "$ref": "#/$defs/binding"
        },
        "canonicalOutputSchema": {
          "$ref": "#/$defs/binding"
        },
        "canonicalReceiptSchema": {
          "$ref": "#/$defs/binding"
        },
        "providerConfig": {
          "$ref": "#/$defs/binding"
        },
        "historicalEvidenceIndex": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "byteLength",
            "sha256",
            "indexDigest"
          ],
          "properties": {
            "path": {
              "const": "implementation/governance/independent-review/evidence/kimi-k3-single-call-20260731/historical-evidence-index.v1.json"
            },
            "byteLength": {
              "$ref": "#/$defs/byteLength"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "indexDigest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "historicalEvidenceIndexSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "byteLength",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "implementation/governance/schemas/independent-review-historical-evidence-index.v1.schema.json"
            },
            "byteLength": {
              "$ref": "#/$defs/byteLength"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "encoding",
          "byteLength",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "REVIEW_BUNDLE",
              "PATCH",
              "SOURCE",
              "SPECIFICATION",
              "TEST_EVIDENCE",
              "GOVERNANCE"
            ]
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "encoding": {
            "const": "UTF-8"
          },
          "byteLength": {
            "$ref": "#/$defs/byteLength"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "priorReviewEvidenceReferences": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reviewId",
          "reviewIdProvenance",
          "path",
          "evidenceOriginCommit",
          "evidenceOriginTree",
          "gitMode",
          "byteLength",
          "sha256",
          "indexEntrySha256"
        ],
        "properties": {
          "kind": {
            "const": "PRIOR_REVIEW_EVIDENCE_REFERENCE"
          },
          "reviewId": {
            "$ref": "#/$defs/reviewId"
          },
          "reviewIdProvenance": {
            "const": "INDEX_LOCAL_LINEAGE_ONLY_NO_RECEIPT"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "evidenceOriginCommit": {
            "const": "e40dd122ba323b825906e3362aea2cc37748ef7a"
          },
          "evidenceOriginTree": {
            "const": "ecc0c179792aa244037bd283a326da58d90f49e3"
          },
          "gitMode": {
            "const": "100644"
          },
          "byteLength": {
            "$ref": "#/$defs/byteLength"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "indexEntrySha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "sectionSetSha256": {
      "$ref": "#/$defs/sha256"
    },
    "priorReviewEvidenceReferenceSetSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewedPathCoverageSha256": {
      "$ref": "#/$defs/sha256"
    },
    "totalSectionUtf8ByteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "contextBudgetUtf8Bytes": {
      "description": "Legacy envelope field name retained for v1-v3 parser compatibility. In v4 this is only the transport resource ceiling, never token-context proof.",
      "const": 4194304
    },
    "resourceCeilingBasis": {
      "const": "TRANSPORT_RESOURCE_CEILING_ONLY_NOT_CONTEXT_PROOF"
    },
    "materialSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^imrr_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\]).+$"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4194304
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "byteLength": {
          "$ref": "#/$defs/byteLength"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
