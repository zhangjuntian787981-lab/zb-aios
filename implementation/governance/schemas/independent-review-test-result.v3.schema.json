{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-review-test-result.v3.schema.json",
  "title": "Independent Review Test Result v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "testPlanSha256",
    "sourceCommit",
    "sourceTree",
    "runner",
    "runtimeBinding",
    "executionSource",
    "commandId",
    "argvSha256",
    "observation",
    "testSummary",
    "stdoutRef",
    "stdoutSha256",
    "stdoutByteLength",
    "stderrRef",
    "stderrSha256",
    "stderrByteLength",
    "resultSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "independent-review-test-result.v3"
    },
    "evidenceId": {
      "$ref": "#/$defs/commandId"
    },
    "testPlanSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "sourceTree": {
      "$ref": "#/$defs/commit"
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "gitBlobSha256",
        "executedBytesSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "gitBlobSha256": {
          "$ref": "#/$defs/sha256"
        },
        "executedBytesSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactRef",
        "artifactSha256",
        "artifactByteLength",
        "bindingSha256",
        "nodeExecutableSha256",
        "dependencySetSha256",
        "gitToolchainSha256",
        "systemToolchainSha256",
        "generator"
      ],
      "properties": {
        "artifactRef": {
          "const": "runtime-binding.v1.json"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifactByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "bindingSha256": {
          "$ref": "#/$defs/sha256"
        },
        "nodeExecutableSha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependencySetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "gitToolchainSha256": {
          "$ref": "#/$defs/sha256"
        },
        "systemToolchainSha256": {
          "$ref": "#/$defs/sha256"
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "gitBlobSha256",
            "executedBytesSha256"
          ],
          "properties": {
            "path": {
              "const": "lib/independent-review-runtime-binding.mjs"
            },
            "gitBlobSha256": {
              "$ref": "#/$defs/sha256"
            },
            "executedBytesSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "executionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "cloneMode",
        "before",
        "after",
        "unchanged",
        "gitHistory",
        "sourceExportRemoved",
        "sandbox"
      ],
      "properties": {
        "mode": {
          "const": "MACOS_SEATBELT_GIT_ARCHIVE_READONLY_HISTORY_V3"
        },
        "cloneMode": {
          "const": "GIT_ARCHIVE_WITH_READ_ONLY_HISTORY_SNAPSHOT"
        },
        "before": {
          "$ref": "#/$defs/executionSnapshot"
        },
        "after": {
          "$ref": "#/$defs/executionSnapshot"
        },
        "unchanged": {
          "const": true
        },
        "gitHistory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "sourceCommit",
            "sourceTree",
            "refTipCount",
            "refTipSetSha256",
            "reachableObjectCount",
            "reachableObjectSetSha256",
            "pointerSha256",
            "beforeManifestSha256",
            "afterManifestSha256",
            "unchanged",
            "metadataWritable"
          ],
          "properties": {
            "mode": {
              "const": "READ_ONLY_ALL_REF_REACHABLE_OBJECT_SNAPSHOT"
            },
            "sourceCommit": {
              "$ref": "#/$defs/commit"
            },
            "sourceTree": {
              "$ref": "#/$defs/commit"
            },
            "refTipCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "refTipSetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "reachableObjectCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "reachableObjectSetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "pointerSha256": {
              "$ref": "#/$defs/sha256"
            },
            "beforeManifestSha256": {
              "$ref": "#/$defs/sha256"
            },
            "afterManifestSha256": {
              "$ref": "#/$defs/sha256"
            },
            "unchanged": {
              "const": true
            },
            "metadataWritable": {
              "const": false
            }
          }
        },
        "sourceExportRemoved": {
          "const": true
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "templatePath",
            "templateSha256",
            "parameterSetSha256",
            "invocationSha256",
            "sourceWritable",
            "buildOutputsWritable",
            "writableWorkRoots",
            "scratchWritable",
            "gitMetadataPresent",
            "gitMetadataWritable",
            "sharedDependenciesWritable",
            "networkPolicy",
            "networkDependentTestMode"
          ],
          "properties": {
            "executable": {
              "const": "/usr/bin/sandbox-exec"
            },
            "templatePath": {
              "const": "implementation/governance/independent-review/macos-independent-review-test-execution.sb.in"
            },
            "templateSha256": {
              "$ref": "#/$defs/sha256"
            },
            "parameterSetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "invocationSha256": {
              "$ref": "#/$defs/sha256"
            },
            "sourceWritable": {
              "const": false
            },
            "buildOutputsWritable": {
              "const": true
            },
            "writableWorkRoots": {
              "const": [
                ".next",
                ".vinext",
                ".wrangler",
                "dist",
                "node_modules/.vite-temp"
              ]
            },
            "scratchWritable": {
              "const": true
            },
            "gitMetadataPresent": {
              "const": true
            },
            "gitMetadataWritable": {
              "const": false
            },
            "sharedDependenciesWritable": {
              "const": false
            },
            "networkPolicy": {
              "const": "DENY_ALL"
            },
            "networkDependentTestMode": {
              "const": "FROZEN_DETERMINISTIC_OFFLINE_ALTERNATIVES"
            }
          }
        }
      }
    },
    "commandId": {
      "$ref": "#/$defs/commandId"
    },
    "argvSha256": {
      "$ref": "#/$defs/sha256"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "signal",
        "timedOut",
        "startedAt",
        "finishedAt"
      ],
      "properties": {
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "signal": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "timedOut": {
          "type": "boolean"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "testSummary": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "tests",
            "pass",
            "fail",
            "cancelled",
            "skipped",
            "todo",
            "skippedTestNames",
            "skippedTestSetSha256"
          ],
          "properties": {
            "format": {
              "const": "NODE_TEST_TAP"
            },
            "tests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "pass": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "fail": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "todo": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "skippedTestNames": {
              "type": "array",
              "maxItems": 4096,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\u0000-\\u001f]+$"
              }
            },
            "skippedTestSetSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "stdoutRef": {
      "$ref": "#/$defs/path"
    },
    "stdoutSha256": {
      "$ref": "#/$defs/sha256"
    },
    "stdoutByteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "stderrRef": {
      "$ref": "#/$defs/path"
    },
    "stderrSha256": {
      "$ref": "#/$defs/sha256"
    },
    "stderrByteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "resultSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    },
    "executionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "tree",
        "sourceManifestSha256"
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/commit"
        },
        "tree": {
          "$ref": "#/$defs/commit"
        },
        "sourceManifestSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
