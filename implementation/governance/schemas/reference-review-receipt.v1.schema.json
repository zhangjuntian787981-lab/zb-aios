{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reference-review-receipt.v1.schema.json",
  "title": "Reference Review Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "workPackageId",
    "reviewMode",
    "reviewBoundary",
    "applicableReferenceSetDigest",
    "referenceCatalogSha256",
    "referencePolicySha256",
    "profileSha256",
    "referenceId",
    "referenceKind",
    "referenceName",
    "officialSources",
    "reviewedMaterials",
    "reviewedSections",
    "reviewedAt",
    "capabilityGap",
    "currentImplementation",
    "alternativesCompared",
    "licenseAndRedistributionAssessment",
    "securityAndDataFlowAssessment",
    "maintenanceAndExitAssessment",
    "decision",
    "decisionReason",
    "alternativePath",
    "reReviewTrigger",
    "notApplicableReason",
    "pocRequired",
    "pocResult",
    "adrRef",
    "ownerRole",
    "evidenceRefs",
    "evidenceHashes",
    "sourceCommit",
    "supersedesReceiptId",
    "governanceEffect",
    "isProgressTracker",
    "selfAuthorizing",
    "productionAdoptionClaim",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reference-review-receipt.v1"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^rrr_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "workPackageId": {
      "type": "string",
      "pattern": "^(F|C|O|T)[0-9]{2}$"
    },
    "reviewMode": {
      "enum": [
        "PROSPECTIVE",
        "RETROSPECTIVE_BACKFILL"
      ]
    },
    "reviewBoundary": {
      "enum": [
        "PRE_START",
        "DEPENDENCY_ADOPTION",
        "IMPLEMENTATION_CONFORMANCE"
      ]
    },
    "applicableReferenceSetDigest": {
      "$ref": "#/$defs/sha256"
    },
    "referenceCatalogSha256": {
      "$ref": "#/$defs/sha256"
    },
    "referencePolicySha256": {
      "$ref": "#/$defs/sha256"
    },
    "profileSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "referenceId": {
      "type": "string",
      "pattern": "^R[0-9]{2}\\.[A-Z0-9][A-Z0-9_]{1,63}$"
    },
    "referenceKind": {
      "enum": [
        "OPEN_SOURCE_PROJECT",
        "STANDARD",
        "OFFICIAL_TECHNICAL_DOCUMENTATION"
      ]
    },
    "referenceName": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "officialSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/officialSource"
      }
    },
    "reviewedMaterials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewedMaterial"
      }
    },
    "reviewedSections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewedSection"
      }
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "capabilityGap": {
      "$ref": "#/$defs/capabilityGap"
    },
    "currentImplementation": {
      "$ref": "#/$defs/currentImplementation"
    },
    "alternativesCompared": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/alternative"
      }
    },
    "licenseAndRedistributionAssessment": {
      "$ref": "#/$defs/licenseAssessment"
    },
    "securityAndDataFlowAssessment": {
      "$ref": "#/$defs/securityAssessment"
    },
    "maintenanceAndExitAssessment": {
      "$ref": "#/$defs/maintenanceAssessment"
    },
    "decision": {
      "enum": [
        "ADOPT",
        "REJECT",
        "DEFER",
        "NOT_APPLICABLE"
      ]
    },
    "decisionReason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "alternativePath": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "reReviewTrigger": {
      "anyOf": [
        {
          "$ref": "#/$defs/reReviewTrigger"
        },
        {
          "type": "null"
        }
      ]
    },
    "notApplicableReason": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "pocRequired": {
      "type": "boolean"
    },
    "pocResult": {
      "$ref": "#/$defs/pocResult"
    },
    "adrRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^docs/adr/[0-9]{4}-[a-z0-9-]+\\.md$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ownerRole": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "evidenceRefs": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "evidenceHashes": {
      "$ref": "#/$defs/sha256Array"
    },
    "sourceCommit": {
      "$ref": "#/$defs/gitCommit"
    },
    "supersedesReceiptId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^rrr_[a-z0-9][a-z0-9_-]{7,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "governanceEffect": {
      "const": "NONE"
    },
    "isProgressTracker": {
      "const": false
    },
    "selfAuthorizing": {
      "const": false
    },
    "productionAdoptionClaim": {
      "const": false
    },
    "receiptSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "sha256Array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "officialSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "uri",
        "authority",
        "sourceKind",
        "observedAt",
        "contentEvidenceRef",
        "contentSha256"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^src_[a-z0-9][a-z0-9_-]{2,127}$"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "authority": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceKind": {
          "enum": [
            "OFFICIAL_DOCUMENTATION",
            "OFFICIAL_SOURCE_REPOSITORY",
            "OFFICIAL_RELEASE",
            "OFFICIAL_LICENSE_TEXT",
            "OFFICIAL_STANDARD"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "contentEvidenceRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewedMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialId",
        "sourceId",
        "materialKind",
        "documentationVersion",
        "sourceCommit",
        "release",
        "imageDigest",
        "artifactDigest"
      ],
      "properties": {
        "materialId": {
          "type": "string",
          "pattern": "^mat_[a-z0-9][a-z0-9_-]{2,127}$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^src_[a-z0-9][a-z0-9_-]{2,127}$"
        },
        "materialKind": {
          "enum": [
            "DOCUMENTATION",
            "SOURCE_COMMIT",
            "RELEASE",
            "IMAGE",
            "STANDARD_EDITION"
          ]
        },
        "documentationVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceCommit": {
          "anyOf": [
            {
              "$ref": "#/$defs/gitCommit"
            },
            {
              "type": "null"
            }
          ]
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "imageDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifactDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reviewedSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "locator",
        "topic",
        "notesRef",
        "notesDigest"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^src_[a-z0-9][a-z0-9_-]{2,127}$"
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "topic": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notesRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notesDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "capabilityGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "currentMeasure",
        "targetMeasure",
        "evidenceRef",
        "evidenceHash"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "currentMeasure": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "targetMeasure": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidenceRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidenceHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "currentImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "evidenceRefs",
        "evidenceHashes"
      ],
      "properties": {
        "status": {
          "enum": [
            "NONE",
            "CANDIDATE",
            "IMPLEMENTED",
            "VERIFIED"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "evidenceHashes": {
          "$ref": "#/$defs/sha256Array"
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternativeId",
        "name",
        "kind",
        "versionOrStandard",
        "advantages",
        "risks",
        "disposition"
      ],
      "properties": {
        "alternativeId": {
          "type": "string",
          "pattern": "^alt_[a-z0-9][a-z0-9_-]{2,127}$"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": [
            "CURRENT_IMPLEMENTATION",
            "OPEN_SOURCE_PROJECT",
            "STANDARD",
            "OFFICIAL_TECHNICAL_APPROACH"
          ]
        },
        "versionOrStandard": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "advantages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "disposition": {
          "enum": [
            "SELECTED",
            "NOT_SELECTED",
            "FALLBACK"
          ]
        }
      }
    },
    "licenseAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "licenseId",
        "licenseSourceId",
        "reviewedVersion",
        "usageMode",
        "distributionMode",
        "obligations",
        "brandRestrictions",
        "commercialRestrictions",
        "conclusion",
        "rationale"
      ],
      "properties": {
        "licenseId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "licenseSourceId": {
          "type": "string",
          "pattern": "^src_[a-z0-9][a-z0-9_-]{2,127}$"
        },
        "reviewedVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "usageMode": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "distributionMode": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "obligations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "brandRestrictions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "commercialRestrictions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "conclusion": {
          "enum": [
            "ACCEPTABLE",
            "UNACCEPTABLE",
            "NOT_APPLICABLE",
            "UNRESOLVED"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "securityAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataClasses",
        "ingress",
        "egress",
        "storage",
        "networkAccess",
        "privileges",
        "secretHandling",
        "trustBoundaries",
        "knownRisks",
        "conclusion",
        "rationale"
      ],
      "properties": {
        "dataClasses": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "ingress": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "egress": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "storage": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "networkAccess": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "privileges": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "secretHandling": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "trustBoundaries": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "knownRisks": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "conclusion": {
          "enum": [
            "ACCEPTABLE",
            "UNACCEPTABLE",
            "NOT_APPLICABLE",
            "UNRESOLVED"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "maintenanceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationalOwnerRole",
        "upstreamHealth",
        "upgradeCadence",
        "onCallResponsibility",
        "backupAndRecoveryResponsibility",
        "costResponsibility",
        "exitPlanStatus",
        "exitPlan",
        "migrationTarget",
        "stopMaintenanceTrigger"
      ],
      "properties": {
        "operationalOwnerRole": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "upstreamHealth": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "upgradeCadence": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "onCallResponsibility": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "backupAndRecoveryResponsibility": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "costResponsibility": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "exitPlanStatus": {
          "enum": [
            "DEFINED",
            "NOT_APPLICABLE",
            "UNRESOLVED"
          ]
        },
        "exitPlan": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "migrationTarget": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stopMaintenanceTrigger": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "reReviewTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triggerKind",
        "condition",
        "beforeBoundary"
      ],
      "properties": {
        "triggerKind": {
          "enum": [
            "DATE",
            "CAPABILITY_GAP_REACHED",
            "CANDIDATE_SET_CHANGED",
            "PROFILE_CHANGED",
            "VERSION_CHANGED",
            "SECURITY_ADVISORY"
          ]
        },
        "condition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "beforeBoundary": {
          "enum": [
            "PRE_START",
            "DEPENDENCY_ADOPTION",
            "IMPLEMENTATION_CONFORMANCE",
            "RELEASE"
          ]
        }
      }
    },
    "pocResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "evidenceRefs",
        "evidenceHashes"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_REQUIRED"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "evidenceHashes": {
          "$ref": "#/$defs/sha256Array"
        }
      }
    }
  }
}
