{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://zb-aios.local/schemas/independent-model-integration-review-receipt.v1.schema.json", "title": "Independent Model Cross-Cutting Integration Review Receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "segmentPlanSha256", "source", "bundleSha256", "segmentReceiptBindings", "reviewer", "artifacts", "usage", "actualCostMicros", "findings", "findingsSha256", "decision", "conclusion", "modelReviewClearForPreproduction", "humanReviewClaim", "governanceEffect", "startedAt", "finishedAt", "receiptSha256"],
  "properties": {
    "schemaVersion": { "const": "kimi-cross-cutting-integration-receipt.v1" }, "receiptId": { "type": "string", "minLength": 8, "maxLength": 160 }, "segmentPlanSha256": { "$ref": "#/$defs/sha256" }, "source": { "$ref": "#/$defs/source" }, "bundleSha256": { "$ref": "#/$defs/sha256" }, "segmentReceiptBindings": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/receiptBinding" } }, "reviewer": { "$ref": "#/$defs/reviewer" }, "artifacts": { "$ref": "#/$defs/artifacts" }, "usage": { "$ref": "#/$defs/usage" }, "actualCostMicros": { "type": "integer", "minimum": 0, "maximum": 4000000 }, "findings": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/finding" } }, "findingsSha256": { "$ref": "#/$defs/sha256" }, "decision": { "$ref": "#/$defs/decision" }, "conclusion": { "enum": ["INTEGRATION_REVIEW_CLEAR", "INTEGRATION_REVIEW_BLOCKED", "INTEGRATION_REVIEW_INCONCLUSIVE"] }, "modelReviewClearForPreproduction": { "const": false }, "humanReviewClaim": { "const": false }, "governanceEffect": { "const": "NONE" }, "startedAt": { "type": "string", "format": "date-time" }, "finishedAt": { "type": "string", "format": "date-time" }, "receiptSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$" }, "paths": { "type": "array", "uniqueItems": true, "maxItems": 4096, "items": { "$ref": "#/$defs/path" } }, "decision": { "enum": ["CLEAR", "BLOCKED", "INCONCLUSIVE"] },
    "source": { "type": "object", "additionalProperties": false, "required": ["baseCommit", "sourceCommit", "headCommit", "tree", "diffSha256", "changedPathsDigest"], "properties": { "baseCommit": { "$ref": "#/$defs/commit" }, "sourceCommit": { "$ref": "#/$defs/commit" }, "headCommit": { "$ref": "#/$defs/commit" }, "tree": { "$ref": "#/$defs/commit" }, "diffSha256": { "$ref": "#/$defs/sha256" }, "changedPathsDigest": { "$ref": "#/$defs/sha256" } } },
    "receiptBinding": { "type": "object", "additionalProperties": false, "required": ["receiptId", "segmentId", "decision", "receiptSha256", "byteLength", "bytesSha256"], "properties": { "receiptId": { "type": "string", "minLength": 8, "maxLength": 160 }, "segmentId": { "enum": ["GOVERNANCE_LINEAGE", "SCHEMAS_WIRE_CONTRACTS", "RUNTIME_ORCHESTRATION", "TESTS_VERIFICATION"] }, "decision": { "$ref": "#/$defs/decision" }, "receiptSha256": { "$ref": "#/$defs/sha256" }, "byteLength": { "type": "integer", "minimum": 1 }, "bytesSha256": { "$ref": "#/$defs/sha256" } } },
    "reviewer": { "type": "object", "additionalProperties": false, "required": ["provider", "requestedModel", "actualReturnedModel", "reviewerSessionId", "independentOfImplementation"], "properties": { "provider": { "const": "moonshot" }, "requestedModel": { "const": "kimi-k3" }, "actualReturnedModel": { "const": "kimi-k3" }, "reviewerSessionId": { "type": "string", "minLength": 8, "maxLength": 256 }, "independentOfImplementation": { "const": true } } },
    "byteArtifact": { "type": "object", "additionalProperties": false, "required": ["path", "encoding", "byteLength", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "encoding": { "const": "UTF-8" }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 8388608 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "responseArtifact": { "type": "object", "additionalProperties": false, "required": ["path", "encoding", "byteLength", "sha256", "httpStatus", "contentType"], "properties": { "path": { "$ref": "#/$defs/path" }, "encoding": { "const": "UTF-8" }, "byteLength": { "type": "integer", "minimum": 0, "maximum": 1048576 }, "sha256": { "$ref": "#/$defs/sha256" }, "httpStatus": { "const": 200 }, "contentType": { "const": "application/json; charset=utf-8" } } },
    "artifacts": { "type": "object", "additionalProperties": false, "required": ["reviewMaterial", "tokenEstimateEvidence", "transportEvidence", "request", "response", "content", "repositoryBefore", "repositoryAfter"], "properties": { "reviewMaterial": { "$ref": "#/$defs/byteArtifact" }, "tokenEstimateEvidence": { "$ref": "#/$defs/byteArtifact" }, "transportEvidence": { "$ref": "#/$defs/byteArtifact" }, "request": { "$ref": "#/$defs/byteArtifact" }, "response": { "$ref": "#/$defs/responseArtifact" }, "content": { "$ref": "#/$defs/byteArtifact" }, "repositoryBefore": { "$ref": "#/$defs/byteArtifact" }, "repositoryAfter": { "$ref": "#/$defs/byteArtifact" } } },
    "usage": { "type": "object", "additionalProperties": false, "required": ["promptTokens", "completionTokens", "totalTokens", "cachedTokens"], "properties": { "promptTokens": { "type": "integer", "minimum": 0 }, "completionTokens": { "type": "integer", "minimum": 0 }, "totalTokens": { "type": "integer", "minimum": 0 }, "cachedTokens": { "type": "integer", "minimum": 0 } } },
    "finding": { "type": "object", "additionalProperties": false, "required": ["findingId", "severity", "status", "path", "relatedPaths", "startLine", "endLine", "summary", "detailsSha256", "resolutionEvidenceDigests"], "properties": { "findingId": { "type": "string", "minLength": 1, "maxLength": 160 }, "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] }, "status": { "enum": ["OPEN", "RESOLVED"] }, "path": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] }, "relatedPaths": { "$ref": "#/$defs/paths" }, "startLine": { "type": ["integer", "null"], "minimum": 1 }, "endLine": { "type": ["integer", "null"], "minimum": 1 }, "summary": { "type": "string", "minLength": 1, "maxLength": 4096 }, "detailsSha256": { "$ref": "#/$defs/sha256" }, "resolutionEvidenceDigests": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/sha256" } } }
  }
}
}
