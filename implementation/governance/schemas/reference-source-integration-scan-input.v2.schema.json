{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reference-source-integration-scan-input.v2.schema.json",
  "title": "Reference Source Integration Scan Input v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workPackageId",
    "sourceCommit",
    "referenceCatalogSha256",
    "scanKind",
    "inventory",
    "governanceEffect",
    "isProgressTracker",
    "selfAuthorizing",
    "productionAdoptionClaim"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reference-source-integration-scan-input.v2"
    },
    "workPackageId": {
      "$ref": "#/$defs/workPackageId"
    },
    "sourceCommit": {
      "$ref": "#/$defs/gitCommit"
    },
    "referenceCatalogSha256": {
      "$ref": "#/$defs/sha256"
    },
    "scanKind": {
      "const": "SOURCE_INTEGRATION_SCAN"
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "path", "sha256"],
            "properties": {
              "format": {
                "const": "REFERENCE_SOURCE_INTEGRATION_INDEX_V2"
              },
              "path": {
                "$ref": "#/$defs/path"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "governanceEffect": {
      "const": "NONE"
    },
    "isProgressTracker": {
      "const": false
    },
    "selfAuthorizing": {
      "const": false
    },
    "productionAdoptionClaim": {
      "const": false
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "workPackageId": {
      "type": "string",
      "pattern": "^(F|C|O|T)[0-9]{2}$"
    }
  }
}
