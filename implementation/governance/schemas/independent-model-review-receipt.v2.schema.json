{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-model-review-receipt.v2.schema.json",
  "title": "Independent Model Review Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "receiptSchemaVersion",
    "reviewId",
    "policyVersion",
    "policySha256",
    "assuranceLevel",
    "applicablePhase",
    "humanIndependentReviewSatisfied",
    "independentModelReviewRequired",
    "p3HumanReviewRequired",
    "bundleId",
    "bundleSha256",
    "reviewBundleDigest",
    "reviewer",
    "reviewerModel",
    "reviewerSessionId",
    "reviewerIndependentOfImplementation",
    "source",
    "sourceCommit",
    "sourceTree",
    "patchSha256",
    "promptSha256",
    "reviewerPromptSha256",
    "reviewedPaths",
    "findings",
    "testEvidenceDigests",
    "runtimeAttestationPath",
    "runtimeAttestationSha256",
    "modelOutputPath",
    "modelOutputSha256",
    "modelOutputByteLength",
    "isolationProbeResults",
    "repositoryUnchangedBeforeAfter",
    "decision",
    "conclusion",
    "humanReviewClaim",
    "governanceEffect",
    "selfAuthorizing",
    "startedAt",
    "finishedAt",
    "reviewStartedAt",
    "reviewFinishedAt",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "independent-model-review-receipt.v2"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "receiptSchemaVersion": {
      "const": "independent-model-review-receipt.v2"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "policyVersion": {
      "const": "2.0.0-candidate.3"
    },
    "policySha256": {
      "$ref": "#/$defs/sha256"
    },
    "assuranceLevel": {
      "const": "MODEL_ONLY_PREPRODUCTION"
    },
    "applicablePhase": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "humanIndependentReviewSatisfied": {
      "const": false
    },
    "independentModelReviewRequired": {
      "const": true
    },
    "p3HumanReviewRequired": {
      "const": true
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "bundleSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewBundleDigest": {
      "$ref": "#/$defs/sha256"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId",
        "modelFamily",
        "modelVersion",
        "modelVersionEvidence",
        "backendBuildId",
        "diversityLevel"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "modelFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "modelVersionEvidence": {
          "const": "CLI_REQUEST_AND_RUNTIME_REPORTED_MODEL_ID"
        },
        "backendBuildId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "diversityLevel": {
          "enum": [
            "DIFFERENT_MODEL_ID_DIFFERENT_PROVIDER",
            "DIFFERENT_MODEL_ID_DIFFERENT_FAMILY",
            "DIFFERENT_MODEL_ID_SAME_PROVIDER"
          ]
        }
      }
    },
    "reviewerModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reviewerSessionId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "reviewerIndependentOfImplementation": {
      "const": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCommit",
        "sourceCommit",
        "headCommit",
        "tree",
        "diffSha256",
        "changedPathsDigest"
      ],
      "properties": {
        "baseCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "headCommit": {
          "$ref": "#/$defs/commit"
        },
        "tree": {
          "$ref": "#/$defs/commit"
        },
        "diffSha256": {
          "$ref": "#/$defs/sha256"
        },
        "changedPathsDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "sourceTree": {
      "$ref": "#/$defs/commit"
    },
    "patchSha256": {
      "$ref": "#/$defs/sha256"
    },
    "promptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewerPromptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "independent-model-review-output.v2.schema.json#/$defs/finding"
      }
    },
    "testEvidenceDigests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "runtimeAttestationPath": {
      "$ref": "#/$defs/path"
    },
    "runtimeAttestationSha256": {
      "$ref": "#/$defs/sha256"
    },
    "modelOutputPath": {
      "$ref": "#/$defs/path"
    },
    "modelOutputSha256": {
      "$ref": "#/$defs/sha256"
    },
    "modelOutputByteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "isolationProbeResults": {
      "$ref": "#/$defs/isolationProbeResults"
    },
    "repositoryUnchangedBeforeAfter": {
      "$ref": "#/$defs/repositoryUnchangedBeforeAfter"
    },
    "decision": {
      "enum": [
        "CLEAR",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "conclusion": {
      "enum": [
        "MODEL_REVIEW_CLEAR_FOR_PREPRODUCTION",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "humanReviewClaim": {
      "const": false
    },
    "governanceEffect": {
      "const": "NONE"
    },
    "selfAuthorizing": {
      "const": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewStartedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewFinishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "receiptSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    },
    "isolationProbeResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "enforcementMode",
        "results",
        "allPassed"
      ],
      "properties": {
        "schemaVersion": {
          "const": "independent-model-isolation-probes.v1"
        },
        "enforcementMode": {
          "enum": [
            "API_NO_TOOLS",
            "OS_ENFORCED_TARGET_READ_ONLY"
          ]
        },
        "results": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "probeId",
              "status",
              "evidenceRef",
              "evidenceSha256",
              "evidenceByteLength"
            ],
            "properties": {
              "probeId": {
                "enum": [
                  "APPLY_PATCH_DENIED",
                  "BINDING_MISMATCH_FAIL_CLOSED",
                  "CREATE_FILE_DENIED",
                  "DELETE_FILE_DENIED",
                  "D1_SITES_GOVERNANCE_WRITE_UNAVAILABLE",
                  "GIT_COMMIT_AND_TAG_DENIED_PUSH_NOT_ATTEMPTED",
                  "MODIFY_FILE_DENIED",
                  "MOVE_RENAME_DENIED",
                  "MODEL_READ_OUTSIDE_BUNDLE_UNAVAILABLE",
                  "REPOSITORY_UNCHANGED",
                  "REVIEW_BUNDLE_EXACT_READ_ONLY",
                  "SANITIZED_ENVIRONMENT_CREDENTIAL_NAMES_ABSENT"
                ]
              },
              "status": {
                "const": "PASS"
              },
              "evidenceRef": {
                "$ref": "#/$defs/path"
              },
              "evidenceSha256": {
                "$ref": "#/$defs/sha256"
              },
              "evidenceByteLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              }
            }
          }
        },
        "allPassed": {
          "const": true
        }
      }
    },
    "repositoryUnchangedBeforeAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "before",
        "after",
        "unchanged",
        "evidenceSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": "repository-unchanged-proof.v1"
        },
        "before": {
          "$ref": "#/$defs/repositorySnapshot"
        },
        "after": {
          "$ref": "#/$defs/repositorySnapshot"
        },
        "unchanged": {
          "const": true
        },
        "evidenceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "repositorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "tree",
        "statusSha256",
        "protectedFilesDigest"
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/commit"
        },
        "tree": {
          "$ref": "#/$defs/commit"
        },
        "statusSha256": {
          "$ref": "#/$defs/sha256"
        },
        "protectedFilesDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
