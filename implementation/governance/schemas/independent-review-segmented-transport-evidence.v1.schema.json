{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zb-aios.local/schemas/independent-review-segmented-transport-evidence.v1.schema.json",
  "title": "Independent Review Segmented Transport Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "evidenceId", "reviewKind", "provider",
    "requestedModel", "actualReturnedModel", "responseId", "baseURL",
    "endpoint", "source", "bindings", "request", "response", "content",
    "repositoryBefore", "repositoryAfter", "protocol", "usage", "cost",
    "validators", "startedAt", "finishedAt", "transportEvidenceSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "independent-review-segmented-transport-evidence.v1" },
    "evidenceId": { "type": "string", "pattern": "^irste_[a-z0-9][a-z0-9_-]{7,127}$" },
    "reviewKind": { "enum": ["SEGMENT", "INTEGRATION"] },
    "provider": { "const": "moonshot" },
    "requestedModel": { "const": "kimi-k3" },
    "actualReturnedModel": { "const": "kimi-k3" },
    "responseId": { "type": "string", "pattern": "^chatcmpl_[A-Za-z0-9_-]{8,255}$" },
    "baseURL": { "const": "https://api.moonshot.ai/v1" },
    "endpoint": { "const": "/chat/completions" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceCommit", "sourceTree"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "sourceTree": { "$ref": "#/$defs/commit" }
      }
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": [
        "segmentPlanSha256", "reviewBundleSha256", "reviewMaterialSha256",
        "reviewerPromptSha256", "canonicalOutputSchemaSha256",
        "providerTransportSchemaSha256", "providerConfigSha256",
        "receiptSchemaSha256", "tokenEstimateEvidenceSchemaSha256",
        "tokenEstimateEvidenceSha256", "segmentedTransportEvidenceSchemaSha256",
        "formalRequestSha256", "messagesSha256", "nonMessageVisibleInputSha256"
      ],
      "properties": {
        "segmentPlanSha256": { "$ref": "#/$defs/sha256" },
        "reviewBundleSha256": { "$ref": "#/$defs/sha256" },
        "reviewMaterialSha256": { "$ref": "#/$defs/sha256" },
        "reviewerPromptSha256": { "$ref": "#/$defs/sha256" },
        "canonicalOutputSchemaSha256": { "$ref": "#/$defs/sha256" },
        "providerTransportSchemaSha256": { "$ref": "#/$defs/sha256" },
        "providerConfigSha256": { "$ref": "#/$defs/sha256" },
        "receiptSchemaSha256": { "$ref": "#/$defs/sha256" },
        "tokenEstimateEvidenceSchemaSha256": { "$ref": "#/$defs/sha256" },
        "tokenEstimateEvidenceSha256": { "$ref": "#/$defs/sha256" },
        "segmentedTransportEvidenceSchemaSha256": { "$ref": "#/$defs/sha256" },
        "formalRequestSha256": { "$ref": "#/$defs/sha256" },
        "messagesSha256": { "$ref": "#/$defs/sha256" },
        "nonMessageVisibleInputSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "request": { "$ref": "#/$defs/byteArtifact" },
    "response": { "$ref": "#/$defs/responseArtifact" },
    "content": { "$ref": "#/$defs/byteArtifact" },
    "repositoryBefore": { "$ref": "#/$defs/byteArtifact" },
    "repositoryAfter": { "$ref": "#/$defs/byteArtifact" },
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": [
        "toolsAbsent", "toolChoiceNone", "thinkingAbsent", "reasoningEffort",
        "strictSchema", "maxCompletionTokens", "networkAttemptCount",
        "choiceCount", "finishReason", "providerTransportSchemaValidated",
        "canonicalOutputSchemaValidated", "semanticValidated"
      ],
      "properties": {
        "toolsAbsent": { "const": true },
        "toolChoiceNone": { "const": true },
        "thinkingAbsent": { "const": true },
        "reasoningEffort": { "const": "max" },
        "strictSchema": { "const": true },
        "maxCompletionTokens": { "const": 32768 },
        "networkAttemptCount": { "const": 1 },
        "choiceCount": { "const": 1 },
        "finishReason": { "const": "stop" },
        "providerTransportSchemaValidated": { "const": true },
        "canonicalOutputSchemaValidated": { "const": true },
        "semanticValidated": { "const": true }
      }
    },
    "usage": { "$ref": "#/$defs/usage" },
    "cost": { "$ref": "#/$defs/cost" },
    "validators": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaValidatorVersion", "semanticValidatorVersion"],
      "properties": {
        "schemaValidatorVersion": { "const": "ajv@8.20.0" },
        "semanticValidatorVersion": { "const": "kimi-k3-segmented-independent-review-validator.v1" }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "transportEvidenceSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "path": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    },
    "byteArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "encoding", "byteLength", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "encoding": { "const": "UTF-8" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "responseArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "encoding", "byteLength", "sha256", "httpStatus", "contentType"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "encoding": { "const": "UTF-8" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "httpStatus": { "const": 200 },
        "contentType": { "const": "application/json; charset=utf-8" }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["promptTokens", "completionTokens", "totalTokens", "cachedTokens"],
      "properties": {
        "promptTokens": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "completionTokens": { "type": "integer", "minimum": 0, "maximum": 32768 },
        "totalTokens": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "cachedTokens": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "taxBasis", "inputMicros", "outputMicros", "totalMicros", "budgetMicros", "withinBudget"],
      "properties": {
        "currency": { "const": "USD" },
        "taxBasis": { "const": "TAX_EXCLUSIVE" },
        "inputMicros": { "type": "integer", "minimum": 0 },
        "outputMicros": { "type": "integer", "minimum": 0 },
        "totalMicros": { "type": "integer", "minimum": 0 },
        "budgetMicros": { "const": 4000000 },
        "withinBudget": { "const": true }
      }
    }
  }
}
