{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reference-implementation-conformance.v1.schema.json",
  "title": "Reference Implementation Conformance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workPackageId",
    "sourceCommit",
    "referenceId",
    "artifactDigest",
    "dependencyLock",
    "sourceIntegration",
    "governanceEffect",
    "isProgressTracker",
    "selfAuthorizing",
    "productionAdoptionClaim"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reference-implementation-conformance.v1"
    },
    "workPackageId": {
      "$ref": "#/$defs/workPackageId"
    },
    "sourceCommit": {
      "$ref": "#/$defs/gitCommit"
    },
    "referenceId": {
      "$ref": "#/$defs/referenceId"
    },
    "artifactDigest": {
      "$ref": "#/$defs/sha256"
    },
    "dependencyLock": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "artifactDigest",
            "toolLockDomain",
            "evidenceRef",
            "evidenceHash"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "artifactDigest": {
              "$ref": "#/$defs/sha256"
            },
            "toolLockDomain": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidenceRef": {
              "$ref": "#/$defs/path"
            },
            "evidenceHash": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceIntegration": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifier",
            "officialSourceUri",
            "integrationKind",
            "sourcePath",
            "sourceHash"
          ],
          "properties": {
            "identifier": {
              "type": "string",
              "minLength": 1
            },
            "officialSourceUri": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "integrationKind": {
              "enum": [
                "API_CLIENT",
                "BUILD_PLUGIN",
                "IMAGE",
                "IMPORT",
                "RUNTIME_PLUGIN",
                "SERVICE_ENDPOINT"
              ]
            },
            "sourcePath": {
              "$ref": "#/$defs/path"
            },
            "sourceHash": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "governanceEffect": {
      "const": "NONE"
    },
    "isProgressTracker": {
      "const": false
    },
    "selfAuthorizing": {
      "const": false
    },
    "productionAdoptionClaim": {
      "const": false
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "workPackageId": {
      "type": "string",
      "pattern": "^(F|C|O|T)[0-9]{2}$"
    },
    "referenceId": {
      "type": "string",
      "pattern": "^R[0-9]{2}\\.[A-Z0-9][A-Z0-9_]{1,63}$"
    }
  }
}
